+func (r *Router) RepairTick() {
+	c := r.repairCfg()
+	if !c.Enabled {
+		return
+	}
+	now := time.Now().Unix()
+	if last, _ := strconv.ParseInt(strings.TrimSpace(r.Store.Get(repairLastKey)), 10, 64); last > 0 && now-last < int64(c.IntervalMin)*60 {
+		return
+	}
+	if !repairBusy.CompareAndSwap(false, true) {
+		return
+	}
+	r.Store.Put(repairLastKey, strconv.FormatInt(now, 10), 0)
+	go func() {
+		defer repairBusy.Store(false)
+		r.repairRun(c)
+	}()
+}
+
+const repairUsageAlertKey = "repair_usage_alert"
+
+func repairBytes(n float64) string {
+	if n <= 0 {
+		return "۰"
+	}
+	gb := n / (1024 * 1024 * 1024)
+	if gb >= 1024 {
+		return fmt.Sprintf("%.2f TB", gb/1024)
+	}
+	if gb >= 1 {
+		return fmt.Sprintf("%.1f GB", gb)
+	}
+	return fmt.Sprintf("%.0f MB", n/(1024*1024))
+}
+
+// RepairUsageTick watches the volume of every configured test user and sends a
+// Telegram alert the first time its allowance is exhausted. The flag is cleared
+// when the user is renewed/reset, so the next exhaustion alerts again.
+func (r *Router) RepairUsageTick() {
+	c := r.repairCfg()
+	panels := r.PanelsRaw()
+	if len(panels) == 0 {
+		return
+	}
+	var alerted map[string]bool
+	_ = r.Store.GetJSON(repairUsageAlertKey, &alerted)
+	if alerted == nil {
+		alerted = map[string]bool{}
+	}
+	changed := false
+	for i, p := range panels {
+		uname := strings.TrimSpace(c.TestUsers[repairPanelKey(p.URL)])
+		if uname == "" {
+			uname = strings.TrimSpace(c.TestUsers[strconv.Itoa(i)])
+		}
+		if uname == "" {
+			continue
+		}
+		cli := p.Client()
+		tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+		if err != nil {
+			continue
+		}
+		u, ok := cli.UserUsage(tok, uname)
+		if !ok {
+			continue
+		}
+		key := repairPanelKey(p.URL) + ":" + uname
+		done := strings.EqualFold(u.Status, "limited") || (u.Limit > 0 && u.Used >= u.Limit)
+		switch {
+		case done && !alerted[key]:
+			alerted[key] = true
+			changed = true
+			if r.Bot != nil {
+				limit := "نامحدود"
+				if u.Limit > 0 {
+					limit = repairBytes(u.Limit)
+				}
+				msg := fmt.Sprintf("⚠️ <b>حجم یوزر تست تمام شد</b>\nپنل: %s\nیوزر: <code>%s</code>\nمصرف: %s از %s",
+					Esc(pname(p)), Esc(uname), repairBytes(u.Used), limit)
+				go r.Bot.Send(r.AdminID, msg, nil)
+			}
+		case !done && alerted[key]:
+			delete(alerted, key)
+			changed = true
+		}
+	}
+	if changed {
+		r.Store.PutJSON(repairUsageAlertKey, alerted, 0)
+	}
+}
