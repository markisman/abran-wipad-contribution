+// webRepairChatReset clears the persisted chat of one config (or all when the
+// filter is empty). It never touches the panel or the repair history.
+func (r *Router) webRepairChatReset(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Panel  string `json:"panel"`
+		HostID string `json:"hostId"`
+		All    bool   `json:"all"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	list := r.repairChatList()
+	if in.All || (strings.TrimSpace(in.Panel) == "" && strings.TrimSpace(in.HostID) == "") {
+		r.Store.PutJSON(repairChatKey, []repairChatEntry{}, 0)
+		r.repairAgentSessionClear()
+		webOK(w, map[string]any{"ok": true})
+		return
+	}
+	kept := make([]repairChatEntry, 0, len(list))
+	for _, e := range list {
+		if e.Panel == in.Panel && e.HostID == in.HostID {
+			continue
+		}
+		kept = append(kept, e)
+	}
+	r.Store.PutJSON(repairChatKey, kept, 0)
+	r.repairAgentSessionDel(in.Panel, in.HostID)
+	webOK(w, map[string]any{"ok": true, "removed": len(list) - len(kept)})
+}
