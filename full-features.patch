+// repairPruneHosts drops cards that belong to panels that no longer exist.
+func (r *Router) repairPruneHosts() []map[string]any {
+	list := r.repairHosts()
+	urls := map[string]bool{}
+	for _, p := range r.PanelsRaw() {
+		urls[repairPanelKey(p.URL)] = true
+	}
+	kept := make([]map[string]any, 0, len(list))
+	removed := false
+	for _, h := range list {
+		if urls[repairPanelKey(strv(h["panelUrl"]))] {
+			kept = append(kept, h)
+		} else {
+			removed = true
+		}
+	}
+	if removed {
+		r.Store.PutJSON(repairHostsKey, kept, 0)
+	}
+	return kept
+}
