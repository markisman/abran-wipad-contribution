+type FirewallEvent struct {
+	Action     string `json:"action"`
+	RuleID     string `json:"ruleId"`
+	RayName    string `json:"rayName"`
+	Source     string `json:"source"`
+	DateTime   string `json:"datetime"`
+	Host       string `json:"host"`
+	Path       string `json:"path"`
+	Method     string `json:"method"`
+	UserAgent  string `json:"userAgent"`
+	EdgeStatus int    `json:"edgeResponseStatus"`
+}
+
+func (c *Client) FirewallEvents(zoneID, ray string, hours, limit int) ([]FirewallEvent, error) {
+	if hours <= 0 {
+		hours = 24
+	}
+	if limit <= 0 || limit > 500 {
+		limit = 100
+	}
+	since := time.Now().UTC().Add(-time.Duration(hours) * time.Hour).Format("2006-01-02T15:04:05Z")
+	filter := `datetime_geq:"` + since + `"`
+	if r := strings.TrimSpace(ray); r != "" {
+		filter += `,rayName:"` + gqlEsc(r) + `"`
+	}
+	q := `{viewer{zones(filter:{zoneTag:"` + gqlEsc(zoneID) + `"}){firewallEventsAdaptive(limit:` + fmt.Sprintf("%d", limit) + `,filter:{` + filter + `},orderBy:[datetime_DESC]){action ruleId rayName source datetime clientRequestHTTPHost clientRequestPath clientRequestHTTPMethod userAgent edgeResponseStatus}}}}`
+	d, err := gql(c.token, q)
+	if err != nil {
+		return nil, err
+	}
+	viewer, _ := d["viewer"].(map[string]any)
+	zones, _ := viewer["zones"].([]any)
+	if len(zones) == 0 {
+		return nil, nil
+	}
+	z, _ := zones[0].(map[string]any)
+	rows, _ := z["firewallEventsAdaptive"].([]any)
+	out := make([]FirewallEvent, 0, len(rows))
+	for _, rv := range rows {
+		m, _ := rv.(map[string]any)
+		if m == nil {
+			continue
+		}
+		out = append(out, FirewallEvent{
+			Action: strAny(m["action"]), RuleID: strAny(m["ruleId"]), RayName: strAny(m["rayName"]),
+			Source: strAny(m["source"]), DateTime: strAny(m["datetime"]),
+			Host: strAny(m["clientRequestHTTPHost"]), Path: strAny(m["clientRequestPath"]),
+			Method: strAny(m["clientRequestHTTPMethod"]), UserAgent: strAny(m["userAgent"]),
+			EdgeStatus: intOr(m["edgeResponseStatus"], 0),
+		})
+	}
+	return out, nil
+}
+
+type CFRule struct {
+	RulesetID   string `json:"rulesetId"`
+	RulesetName string `json:"rulesetName"`
+	Phase       string `json:"phase"`
+	Kind        string `json:"kind"`
+	RuleID      string `json:"ruleId"`
+	Action      string `json:"action"`
+	Description string `json:"description"`
+	Enabled     bool   `json:"enabled"`
+}
+
+func (c *Client) Rulesets(zoneID string) ([]CFRule, error) {
+	type rsRule struct {
+		ID          string `json:"id"`
+		Action      string `json:"action"`
+		Description string `json:"description"`
+		Enabled     bool   `json:"enabled"`
+	}
+	type rs struct {
+		ID      string   `json:"id"`
+		Name    string   `json:"name"`
+		Phase   string   `json:"phase"`
+		Kind    string   `json:"kind"`
+		Version string   `json:"version"`
+		Rules   []rsRule `json:"rules"`
+	}
+	var rss []rs
+	if err := req(c, "GET", "/zones/"+url.PathEscape(zoneID)+"/rulesets?per_page=200", nil, &rss); err != nil {
+		return nil, err
+	}
+	out := make([]CFRule, 0, 32)
+	for _, r := range rss {
+		for _, x := range r.Rules {
+			out = append(out, CFRule{RulesetID: r.ID, RulesetName: r.Name, Phase: r.Phase, Kind: r.Kind, RuleID: x.ID, Action: x.Action, Description: x.Description, Enabled: x.Enabled})
+		}
+	}
+	return out, nil
+}
+
+func (c *Client) AddSkip(zoneID, expression, description string, phases []string) (map[string]any, error) {
+	var entry struct {
+		ID    string           `json:"id"`
+		Rules []map[string]any `json:"rules"`
+	}
+	if err := req(c, "GET", "/zones/"+url.PathEscape(zoneID)+"/rulesets/phases/http_request_firewall_custom/entrypoint", nil, &entry); err != nil {
+		return nil, err
+	}
+	rule := map[string]any{"action": "skip", "expression": expression, "description": description, "enabled": true}
+	if len(phases) > 0 {
+		rule["action_parameters"] = map[string]any{"phases": phases}
+	}
+	entry.Rules = append(entry.Rules, rule)
+	var out map[string]any
+	if err := req(c, "PUT", "/zones/"+url.PathEscape(zoneID)+"/rulesets/phases/http_request_firewall_custom/entrypoint", map[string]any{"rules": entry.Rules}, &out); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+func (c *Client) SetRuleEnabled(zoneID, rulesetID, ruleID string, enabled bool) error {
+	var rs struct {
+		Rules []map[string]any `json:"rules"`
+	}
+	if err := req(c, "GET", "/zones/"+url.PathEscape(zoneID)+"/rulesets/"+url.PathEscape(rulesetID), nil, &rs); err != nil {
+		return err
+	}
+	found := false
+	for i := range rs.Rules {
+		if strAny(rs.Rules[i]["id"]) == ruleID {
+			rs.Rules[i]["enabled"] = enabled
+			found = true
+			break
+		}
+	}
+	if !found {
+		return &Error{"rule پیدا نشد"}
+	}
+	return req(c, "PUT", "/zones/"+url.PathEscape(zoneID)+"/rulesets/"+url.PathEscape(rulesetID), map[string]any{"rules": rs.Rules}, nil)
+}
+
+type WSTestResult struct {
+	URL    string `json:"url"`
+	Status int    `json:"status"`
+	Ray    string `json:"ray"`
+	Server string `json:"server"`
+	Error  string `json:"error"`
+	OK     bool   `json:"ok"`
+}
+
+func (c *Client) TestWebSocket(ctx context.Context, raw string) WSTestResult {
+	res := WSTestResult{URL: raw}
+	u, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || u.Host == "" {
+		res.Error = "URL نامعتبر"
+		return res
+	}
+	switch u.Scheme {
+	case "wss":
+		u.Scheme = "https"
+	case "ws":
+		u.Scheme = "http"
+	case "https", "http":
+	default:
+		res.Error = "scheme باید ws/wss/http/https باشد"
+		return res
+	}
+	key := make([]byte, 16)
+	_, _ = rand.Read(key)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		res.Error = err.Error()
+		return res
+	}
+	req.Header.Set("Connection", "Upgrade")
+	req.Header.Set("Upgrade", "websocket")
+	req.Header.Set("Sec-WebSocket-Version", "13")
+	req.Header.Set("Sec-WebSocket-Key", base64.StdEncoding.EncodeToString(key))
+	req.Header.Set("User-Agent", "CG-CF-Blocks/1.0")
+	hc := &http.Client{Timeout: 15 * time.Second, Transport: &http.Transport{ForceAttemptHTTP2: false, TLSClientConfig: &tls.Config{InsecureSkipVerify: true}}, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	resp, err := hc.Do(req)
+	if err != nil {
+		res.Error = trunc(err.Error(), 200)
+		return res
+	}
+	defer resp.Body.Close()
+	res.Status = resp.StatusCode
+	res.Ray = resp.Header.Get("cf-ray")
+	res.Server = resp.Header.Get("server")
+	res.OK = resp.StatusCode == http.StatusSwitchingProtocols
+	if !res.OK {
+		res.Error = "handshake rejected: " + resp.Status
+	}
+	return res
+}
+
+func gqlEsc(s string) string {
+	s = strings.ReplaceAll(s, `\`, `\\`)
+	return strings.ReplaceAll(s, `"`, `\"`)
+}
