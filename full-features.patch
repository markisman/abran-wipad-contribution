+// webRepairConfigs loads the hosts ("configs") of one panel so the repair page
+// can show what the selected panel actually exposes.
+func (r *Router) webRepairConfigs(w http.ResponseWriter, req *http.Request, uid int64) {
+	idx, _ := strconv.Atoi(strings.TrimSpace(req.URL.Query().Get("idx")))
+	panels := r.PanelsRaw()
+	if idx < 0 || idx >= len(panels) {
+		webErr(w, http.StatusBadRequest, "پنل پیدا نشد")
+		return
+	}
+	p := panels[idx]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	raw, err := cli.Hosts(tok)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن کانفیگ‌ها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	incoming := make([]map[string]any, 0, len(raw))
+	for _, hv := range raw {
+		h, ok := hv.(map[string]any)
+		if !ok {
+			continue
+		}
+		id := strv(h["id"])
+		incoming = append(incoming, map[string]any{
+			"key":         p.URL + "#" + id,
+			"panelName":   pname(p),
+			"panelUrl":    p.URL,
+			"id":          id,
+			"remark":      strv(h["remark"]),
+			"disabled":    boolVal(h["is_disabled"]),
+			"address":     hfList(h["address"]),
+			"port":        h["port"],
+			"sni":         hfList(h["sni"]),
+			"host":        hfList(h["host"]),
+			"path":        strv(h["path"]),
+			"security":    strv(h["security"]),
+			"inbound_tag": strv(h["inbound_tag"]),
+		})
+	}
+	// Replace this panel's previous entries, keep the other panels' cards.
+	merged := make([]map[string]any, 0, len(incoming)+len(raw))
+	for _, h := range r.repairHosts() {
+		if strv(h["panelUrl"]) == p.URL {
+			continue
+		}
+		merged = append(merged, h)
+	}
+	merged = append(merged, incoming...)
+	r.Store.PutJSON(repairHostsKey, merged, 0)
+	webOK(w, map[string]any{
+		"panel": map[string]any{"name": pname(p), "url": p.URL},
+		"hosts": merged,
+		"total": len(merged),
+	})
+}
