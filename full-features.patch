+func (r *Router) runOpenCode(ctx context.Context, c repairCfg, session, contextPath, msg, token string, onStep func(string, int)) (string, []string, string, error) {
+	u, err := user.Lookup(repairAgentUser)
+	if err != nil {
+		return "", nil, "", fmt.Errorf("agent user: %w", err)
+	}
+	uid64, _ := strconv.ParseUint(u.Uid, 10, 32)
+	gid64, _ := strconv.ParseUint(u.Gid, 10, 32)
+	prompt := "ابتدا فایل " + contextPath + " و AGENTS.md را کامل بخوان. سپس درخواست کاربر را انجام بده.\n\n" + msg
+	args := []string{
+		"run", "--format", "json",
+		"--model", repairAgentModel(c),
+		"--auto",
+		"--dir", repairAgentWorkspace,
+	}
+	if strings.TrimSpace(session) != "" {
+		args = append(args, "--session", strings.TrimSpace(session))
+	}
+	args = append(args, prompt)
+	cmd := exec.CommandContext(ctx, repairAgentBin, args...)
+	cmd.Dir = repairAgentWorkspace
+	cmd.Env = []string{
+		"HOME=" + repairAgentHome,
+		"XDG_CONFIG_HOME=" + repairAgentHome + "/.config",
+		"XDG_DATA_HOME=" + repairAgentHome + "/.local/share",
+		"XDG_CACHE_HOME=" + repairAgentHome + "/.cache",
+		"DEEPSEEK_API_KEY=" + c.DSKey,
+		"CG_WEB_TOKEN=" + token,
+		"PATH=/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin",
+		"TERM=dumb",
+		"NO_COLOR=1",
+		"PWD=" + repairAgentWorkspace,
+		"LANG=C.UTF-8",
+		"SHELL=/bin/bash",
+		"USER=" + repairAgentUser,
+		"LOGNAME=" + repairAgentUser,
+		"TMPDIR=/tmp",
+	}
+	cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{
+		Uid: uint32(uid64), Gid: uint32(gid64), Groups: []uint32{uint32(gid64)},
+	}}
+	var stderr bytes.Buffer
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		return "", nil, "", fmt.Errorf("stdout pipe: %w", err)
+	}
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		return "", nil, "", fmt.Errorf("start agent: %w", err)
+	}
+	scanner := bufio.NewScanner(stdout)
+	scanner.Buffer(make([]byte, 0, 64*1024), 4*1024*1024)
+	var texts, steps, stepTexts []string
+	newSession := ""
+	seenStep := map[string]bool{}
+	progress := 20
+	addStep := func(label string) {
+		label = strings.TrimSpace(label)
+		if label == "" || seenStep[label] {
+			return
+		}
+		seenStep[label] = true
+		steps = append(steps, label)
+		if progress < 90 {
+			progress += 5
+		}
+		if onStep != nil {
+			onStep(label, progress)
+		}
+	}
+	runErr := error(nil)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" {
+			continue
+		}
+		var ev repairAgentEvent
+		if json.Unmarshal([]byte(line), &ev) != nil {
+			continue
+		}
+		if ev.SessionID != "" && newSession == "" {
+			newSession = ev.SessionID
+		}
+		switch ev.Type {
+		case "step_start":
+			stepTexts = nil
+		case "text":
+			t := strings.TrimSpace(ev.Part.Text)
+			if t != "" {
+				texts = append(texts, t)
+				stepTexts = append(stepTexts, t)
+				addStep("💭 " + truncRune(t, 180))
+			}
+		case "tool_use", "tool":
+			label := strings.TrimSpace(ev.Part.Tool)
+			var st struct {
+				Status string `json:"status"`
+				Title  string `json:"title"`
+			}
+			_ = json.Unmarshal(ev.Part.State, &st)
+			if st.Title != "" {
+				label += ": " + truncRune(st.Title, 160)
+			}
+			if label != "" {
+				addStep("🔧 " + label)
+			}
+		case "error":
+			if runErr == nil {
+				runErr = fmt.Errorf("%s", truncRune(string(ev.Error), 300))
+			}
+		}
+	}
+	waitErr := cmd.Wait()
+	if ctx.Err() != nil {
+		runErr = fmt.Errorf("timeout: %w", ctx.Err())
+	} else if waitErr != nil && runErr == nil {
+		runErr = waitErr
+	}
+	reply := strings.TrimSpace(strings.Join(stepTexts, "\n\n"))
+	if reply == "" {
+		reply = strings.TrimSpace(strings.Join(texts, "\n\n"))
+	}
+	if runErr != nil {
+		return reply, steps, newSession, fmt.Errorf("%v", runErr)
+	}
+	if reply == "" {
+		return reply, steps, newSession, fmt.Errorf("ایجنت پاسخی نداد")
+	}
+	return reply, steps, newSession, nil
+}
+
+func (r *Router) runRepairAgent(ctx context.Context, j *repairAgentJob, c repairCfg, idx int, p pg.Panel, h map[string]any, hist []repairChatEntry, msg, token string) {
+	ctxText := repairAgentContext(c, idx, p, h, hist, msg)
+	ctxPath := filepath.Join(repairAgentWorkspace, "CONTEXT-"+j.ID+".md")
+	if err := os.WriteFile(ctxPath, []byte(ctxText), 0o644); err != nil {
+		r.finishRepairAgent(j, repairChatEntry{}, ctxText, "", nil, fmt.Errorf("نوشتن CONTEXT ناموفق: %w", err))
+		return
+	}
+	session := r.repairAgentSessionGet(pname(p), strv(h["id"]))
+	r.setRepairAgentProgress(j, 15)
+	stop := make(chan struct{})
+	go func() {
+		p := 15
+		t := time.NewTicker(2 * time.Second)
+		defer t.Stop()
+		for {
+			select {
+			case <-stop:
+				return
+			case <-t.C:
+				if p < 90 {
+					p++
+					r.setRepairAgentProgress(j, p)
+				}
+			}
+		}
+	}()
+	reply, steps, newSession, err := r.runOpenCode(ctx, c, session, ctxPath, msg, token, func(label string, p int) {
+		repairAgentJobsMu.Lock()
+		if label != "" {
+			j.Steps = append(j.Steps, label)
+			if len(j.Steps) > 40 {
+				j.Steps = j.Steps[len(j.Steps)-40:]
+			}
+		}
+		if p > j.Progress {
+			j.Progress = p
+		}
+		repairAgentJobsMu.Unlock()
+	})
+	close(stop)
+	if newSession == "" {
+		newSession = session
+	}
+	if newSession != "" {
+		r.repairAgentSessionSet(pname(p), strv(h["id"]), newSession)
+	}
+	e := repairChatEntry{
+		TS: time.Now().Unix(), Kind: "manual", Panel: pname(p),
+		HostID: strv(h["id"]), HostRemark: strv(h["remark"]), HostAddr: repairAgentHostAddr(h), Port: intOfAny(h["port"]),
+		Model: repairAgentModel(c), System: truncRune(ctxText, 20000), Request: msg, UserText: msg,
+		Response: truncRune(reply, 10000),
+	}
+	r.finishRepairAgent(j, e, ctxText, newSession, steps, err)
+}
+
+func (r *Router) finishRepairAgent(j *repairAgentJob, e repairChatEntry, ctxText, session string, steps []string, err error) {
+	status := "ok"
+	errText := ""
+	if err != nil {
+		status = "error"
+		errText = truncRune(err.Error(), 1000)
+		e.Error = truncRune(err.Error(), 300)
+	}
+	if e.TS == 0 {
+		e.TS = time.Now().Unix()
+	}
+	repairAgentJobsMu.Lock()
+	canceled := j.Status == "canceled"
+	repairAgentJobsMu.Unlock()
+	if canceled {
+		repairAgentJobsMu.Lock()
+		j.Progress = 100
+		j.Status = "canceled"
+		repairAgentJobsMu.Unlock()
+		return
+	}
+	r.repairChatAdd(e)
+	repairAgentJobsMu.Lock()
+	j.Progress = 100
+	j.Status = status
+	j.Reply = e.Response
+	j.Error = errText
+	j.Steps = steps
+	j.Session = session
+	j.Chat = e
+	repairAgentJobsMu.Unlock()
+}
+
+func (r *Router) webRepairAgent(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Index   int    `json:"idx"`
+		HostID  string `json:"hostId"`
+		Message string `json:"message"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	msg := strings.TrimSpace(in.Message)
+	hid := strings.TrimSpace(in.HostID)
+	if msg == "" || hid == "" {
+		webErr(w, http.StatusBadRequest, "متن یا کانفیگ خالی است")
+		return
+	}
+	panels := r.PanelsRaw()
+	if in.Index < 0 || in.Index >= len(panels) {
+		webErr(w, http.StatusBadRequest, "پنل پیدا نشد")
+		return
+	}
+	p := panels[in.Index]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	raw, err := cli.Hosts(tok)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن کانفیگ‌ها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	var host map[string]any
+	for _, hv := range raw {
+		if m, ok := hv.(map[string]any); ok && strv(m["id"]) == hid {
+			host = m
+			break
+		}
+	}
+	if host == nil {
+		webErr(w, http.StatusNotFound, "کانفیگ در پنل پیدا نشد")
+		return
+	}
+	auth := strings.TrimSpace(req.Header.Get("Authorization"))
+	token := strings.TrimSpace(strings.TrimPrefix(auth, "Bearer "))
+	if token == "" {
+		webErr(w, http.StatusUnauthorized, "توکن اجرا پیدا نشد")
+		return
+	}
+	c := r.repairCfg()
+	hist := make([]repairChatEntry, 0, 10)
+	list := r.repairChatList()
+	for i := len(list) - 1; i >= 0 && len(hist) < 10; i-- {
+		e := list[i]
+		if e.Kind == "manual" && e.Panel == pname(p) && e.HostID == hid {
+			hist = append(hist, e)
+		}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), repairAgentTimeout)
+	j := &repairAgentJob{ID: repairAgentNewID(), Status: "running", Started: time.Now().Unix(), Progress: 5, Cancel: cancel}
+	repairAgentJobsMu.Lock()
+	repairAgentJobs[j.ID] = j
+	if len(repairAgentJobs) > 40 {
+		for id, old := range repairAgentJobs {
+			if old.Status != "running" && time.Since(time.Unix(old.Started, 0)) > time.Hour {
+				delete(repairAgentJobs, id)
+			}
+		}
+	}
+	repairAgentJobsMu.Unlock()
+	go r.runRepairAgent(ctx, j, c, in.Index, p, host, hist, msg, token)
+	webOK(w, map[string]any{"id": j.ID, "status": "running"})
+}
+
+func (r *Router) webRepairAgentCancel(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		ID string `json:"id"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	id := strings.TrimSpace(in.ID)
+	repairAgentJobsMu.Lock()
+	j := repairAgentJobs[id]
+	if j != nil && j.Status == "running" {
+		j.Status = "canceled"
+		j.Progress = 100
+		if j.Cancel != nil {
+			j.Cancel()
+		}
+	}
+	repairAgentJobsMu.Unlock()
+	if j == nil {
+		webErr(w, http.StatusNotFound, "job پیدا نشد")
+		return
+	}
+	webOK(w, map[string]any{"ok": true, "status": "canceled"})
+}
+
+func (r *Router) webRepairAgentStatus(w http.ResponseWriter, req *http.Request, uid int64) {
+	id := strings.TrimSpace(req.URL.Query().Get("id"))
+	repairAgentJobsMu.Lock()
+	j := repairAgentJobs[id]
+	out := map[string]any{}
+	if j != nil {
+		out = map[string]any{
+			"id": j.ID, "status": j.Status, "reply": j.Reply, "error": j.Error,
+			"steps": j.Steps, "session": j.Session, "chat": j.Chat, "started": j.Started, "progress": j.Progress,
+		}
+	}
+	repairAgentJobsMu.Unlock()
+	if j == nil {
+		webErr(w, http.StatusNotFound, "job پیدا نشد")
+		return
+	}
+	webOK(w, out)
+}
diff --git a/server/internal/router/repair_promptref_test.go b/server/internal/router/repair_promptref_test.go
new file mode 100644
index 0000000..a40b5df
--- /dev/null
+++ b/server/internal/router/repair_promptref_test.go
@@ -0,0 +1,92 @@
+package router
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestRepairPromptRefsExpandAndAvoidCycles(t *testing.T) {
+	c := repairCfg{
+		Prompt:            "global",
+		PromptIDs:         map[string]string{},
+		HostPromptList:    map[string][]string{},
+		HostPrompts:       map[string]string{},
+		HostPromptAllList: []string{"shared"},
+	}
+	c.HostPromptList["u#1"] = []string{"alpha rule"}
+	c.HostPromptList["u#2"] = []string{"beta rule references #P1 and #P2"}
+	c.HostPromptList["u#3"] = []string{"gamma rule references #P2"}
+	repairEnsurePromptIDs(&c)
+	if c.PromptIDs["u#1"] != "P1" || c.PromptIDs["u#2"] != "P2" || c.PromptIDs["u#3"] != "P3" {
+		t.Fatalf("unexpected ids: %#v", c.PromptIDs)
+	}
+	base := "use #P1 and #P3 and #P1"
+	out := repairAppendPromptRefs(c, base, "u#2")
+	if !strings.Contains(out, "alpha rule") {
+		t.Fatalf("referenced prompt not attached: %q", out)
+	}
+	if !strings.Contains(out, "gamma rule") {
+		t.Fatalf("second referenced prompt not attached: %q", out)
+	}
+	if strings.Contains(out, "beta rule") {
+		t.Fatalf("self prompt must not be attached: %q", out)
+	}
+	if strings.Count(out, "alpha rule") != 1 {
+		t.Fatalf("duplicate reference expanded twice: %q", out)
+	}
+	if !strings.Contains(out, "پرامپت‌های ارجاع‌شده") {
+		t.Fatalf("missing reference header: %q", out)
+	}
+}
+
+func TestRepairPromptRefsNoopWithoutRefs(t *testing.T) {
+	c := repairCfg{Prompt: "g", PromptIDs: map[string]string{"global": "G"}}
+	base := "plain prompt"
+	if got := repairAppendPromptRefs(c, base, ""); got != base {
+		t.Fatalf("unexpected expansion: %q", got)
+	}
+}
+
+func TestRepairPromptItemTags(t *testing.T) {
+	c := repairCfg{
+		Prompt:         "global",
+		PromptIDs:      map[string]string{},
+		HostPromptList: map[string][]string{"u#9": {"first item", "second item"}},
+		HostPrompts:    map[string]string{},
+	}
+	repairEnsurePromptIDs(&c)
+	if c.PromptIDs["u#9"] != "P9" {
+		t.Fatalf("group id: %#v", c.PromptIDs)
+	}
+	ids := c.HostPromptItemIDs["u#9"]
+	if len(ids) != 2 || ids[0] != "P9.1" || ids[1] != "P9.2" {
+		t.Fatalf("item ids: %#v", c.HostPromptItemIDs)
+	}
+	out := repairAppendPromptRefs(c, "use #"+ids[1], "u#10")
+	if !strings.Contains(out, "second item") {
+		t.Fatalf("item prompt not attached: %q", out)
+	}
+	if strings.Contains(out, "first item") {
+		t.Fatalf("only the referenced item must be attached: %q", out)
+	}
+}
+
+func TestRepairUserPromptRefs(t *testing.T) {
+	c := repairCfg{
+		Prompt:         "global rules",
+		PromptIDs:      map[string]string{},
+		HostPromptList: map[string][]string{"u#1": {"alpha item"}},
+		HostPrompts:    map[string]string{},
+	}
+	repairEnsurePromptIDs(&c)
+	out := repairUserPromptRefs(c, "please use #G and #P1.1")
+	if !strings.Contains(out, "global rules") {
+		t.Fatalf("global tag not expanded: %q", out)
+	}
+	if !strings.Contains(out, "alpha item") {
+		t.Fatalf("item tag not expanded: %q", out)
+	}
+	if !strings.Contains(out, "ارجاع‌های پیام شما") {
+		t.Fatalf("missing user reference header: %q", out)
+	}
+}
diff --git a/server/internal/router/repair_workers.go b/server/internal/router/repair_workers.go
new file mode 100644
index 0000000..15c97f5
--- /dev/null
+++ b/server/internal/router/repair_workers.go
@@ -0,0 +1,443 @@
+package router
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	repairWorkersKey = "repair_workers"
+	repairWorkerLogs = "repair_worker_logs"
+)
+
+type repairWorker struct {
+	ID           string   `json:"id"`
+	Name         string   `json:"name"`
+	Prompt       string   `json:"prompt"`
+	Enabled      bool     `json:"enabled"`
+	Schedule     string   `json:"schedule"` // interval | daily
+	IntervalMin  int      `json:"intervalMin"`
+	DailyAt      string   `json:"dailyAt"` // HH:MM
+	Model        string   `json:"model"`   // deepseek-flash | deepseek-v4-pro | ""
+	LastRun      int64    `json:"lastRun"`
+	NextRun      int64    `json:"nextRun"`
+	LastStatus   string   `json:"lastStatus"`
+	LastError    string   `json:"lastError"`
+	LastReply    string   `json:"lastReply"`
+	Progress     int      `json:"progress"`
+	Steps        []string `json:"steps"`
+	LastDuration int64    `json:"lastDuration"`
+	CreatedAt    int64    `json:"createdAt"`
+}
+
+type repairWorkerRun struct {
+	TS       int64    `json:"ts"`
+	Status   string   `json:"status"`
+	Reply    string   `json:"reply"`
+	Error    string   `json:"error"`
+	Steps    []string `json:"steps"`
+	Duration int64    `json:"duration"`
+}
+
+var (
+	repairWorkerMu      sync.Mutex
+	repairWorkerCancels = map[string]context.CancelFunc{}
+	repairWorkerRunning = map[string]bool{}
+)
+
+func repairWorkerNewID() string {
+	var b [8]byte
+	_, _ = rand.Read(b[:])
+	return fmt.Sprintf("w%d-%s", time.Now().UnixNano(), hex.EncodeToString(b[:]))
+}
+
+func (r *Router) repairWorkers() []repairWorker {
+	var list []repairWorker
+	_ = r.Store.GetJSON(repairWorkersKey, &list)
+	if list == nil {
+		list = []repairWorker{}
+	}
+	sort.Slice(list, func(i, j int) bool { return list[i].CreatedAt < list[j].CreatedAt })
+	return list
+}
+
+func (r *Router) repairWorkersSave(list []repairWorker) { r.Store.PutJSON(repairWorkersKey, list, 0) }
+
+func (r *Router) repairWorkerUpdate(id string, fn func(*repairWorker)) {
+	list := r.repairWorkers()
+	for i := range list {
+		if list[i].ID == id {
+			fn(&list[i])
+			r.repairWorkersSave(list)
+			return
+		}
+	}
+}
+
+func (r *Router) repairWorkerLogs() map[string][]repairWorkerRun {
+	out := map[string][]repairWorkerRun{}
+	_ = r.Store.GetJSON(repairWorkerLogs, &out)
+	if out == nil {
+		out = map[string][]repairWorkerRun{}
+	}
+	return out
+}
+
+func (r *Router) repairWorkerLogAdd(id string, run repairWorkerRun) {
+	m := r.repairWorkerLogs()
+	list := append([]repairWorkerRun{run}, m[id]...)
+	if len(list) > 10 {
+		list = list[:10]
+	}
+	m[id] = list
+	r.Store.PutJSON(repairWorkerLogs, m, 0)
+}
+
+func (r *Router) repairWorkerRunningCheck(id string) bool {
+	repairWorkerMu.Lock()
+	defer repairWorkerMu.Unlock()
+	return repairWorkerRunning[id]
+}
+
+func (r *Router) repairWorkerCancel(id string) bool {
+	repairWorkerMu.Lock()
+	cancel := repairWorkerCancels[id]
+	repairWorkerMu.Unlock()
+	if cancel == nil {
+		return false
+	}
+	cancel()
+	r.repairWorkerUpdate(id, func(w *repairWorker) {
+		w.LastStatus = "canceled"
+		w.LastError = "توسط کاربر متوقف شد"
+		w.Progress = 100
+	})
+	return true
+}
+
+func repairWorkerNext(w repairWorker, now time.Time) int64 {
+	if w.Schedule == "daily" {
+		hh, mm := 9, 0
+		if p := strings.Split(strings.TrimSpace(w.DailyAt), ":"); len(p) == 2 {
+			if v, err := strconv.Atoi(p[0]); err == nil && v >= 0 && v < 24 {
+				hh = v
+			}
+			if v, err := strconv.Atoi(p[1]); err == nil && v >= 0 && v < 60 {
+				mm = v
+			}
+		}
+		t := time.Date(now.Year(), now.Month(), now.Day(), hh, mm, 0, 0, now.Location())
+		if !t.After(now) {
+			t = t.AddDate(0, 0, 1)
+		}
+		return t.Unix()
+	}
+	n := w.IntervalMin
+	if n <= 0 {
+		n = 60
+	}
+	return now.Add(time.Duration(n) * time.Minute).Unix()
+}
+
+// issueWorkerToken creates a short-lived admin web session for a worker run.
+// The token is placed only in the agent environment (CG_WEB_TOKEN).
+func (r *Router) issueWorkerToken(ttl time.Duration) string {
+	now := time.Now()
+	exp := now.Add(ttl).Unix()
+	uid := r.AdminID
+	sid := webSessID()
+	webSessMu.Lock()
+	m := r.webSessAll()
+	key := strconv.FormatInt(uid, 10)
+	arr := make([]webSess, 0, len(m[key])+1)
+	for _, s := range m[key] {
+		if s.Exp > now.Unix() {
+			arr = append(arr, s)
+		}
+	}
+	if len(arr) >= webSessMax {
+		arr = arr[len(arr)-webSessMax+1:]
+	}
+	arr = append(arr, webSess{ID: sid, UID: uid, Created: now.Unix(), Exp: exp, Last: now.Unix(), IP: "worker", UA: "cg-worker", Device: "worker"})
+	m[key] = arr
+	r.webSessSave(m)
+	webSessMu.Unlock()
+	return r.webSignSession(uid, exp, sid)
+}
+
+func (r *Router) repairWorkerContext(c repairCfg, w repairWorker, token string) string {
+	var b strings.Builder
+	b.WriteString("# WORKER — Cloud Guardian scheduled agent\n\n")
+	fmt.Fprintf(&b, "Worker: %s\n\n", w.Name)
+	b.WriteString("## Goal / prompt\n")
+	b.WriteString(w.Prompt)
+	b.WriteString("\n\n## Panels\n")
+	for i, p := range r.PanelsRaw() {
+		fmt.Fprintf(&b, "- [%d] %s — %s\n", i, pname(p), p.URL)
+	}
+	b.WriteString("\n## HOST cards (persisted mirror; load real configs from the API)\n")
+	for _, h := range r.repairHosts() {
+		fmt.Fprintf(&b, "- panel=%s id=%s remark=%s address=%s port=%v disabled=%v\n",
+			strv(h["panelName"]), strv(h["id"]), strv(h["remark"]), strings.Join(hfList(h["address"]), ","), h["port"], boolVal(h["disabled"]))
+	}
+	b.WriteString("\n## Prompts (tags: #G / #S1 / #P<hostID>[.n])\n")
+	for _, d := range repairPromptDocs(c) {
+		fmt.Fprintf(&b, "### [%s] %s\n%s\n\n", d.ID, d.Label, d.Text)
+	}
+	b.WriteString("## Feature API\n")
+	b.WriteString("Base: http://127.0.0.1:53128 — token: $CG_WEB_TOKEN (admin, this run only).\n")
+	b.WriteString("- GET /api/tools/repair (panels/hosts/config/log)\n")
+	b.WriteString("- GET /api/tools/repair/configs?idx=N (refresh a panel's hosts)\n")
+	b.WriteString("- POST /api/tools/repair/test {idx,hostId} (real speed/health test)\n")
+	b.WriteString("- POST /api/tools/repair/host {idx,id,disabled} (toggle)\n")
+	b.WriteString("- POST /api/tools/repair/run (run repair engine)\n")
+	b.WriteString("- GET /api/tools/repair/chat; POST /api/tools/repair/chat/reset\n")
+	b.WriteString("\n## Sandbox\n")
+	b.WriteString("- Writable: /opt/cloud-guardian/agent/workspace (feature-server/, feature-webui/, custom-overlay/)\n")
+	b.WriteString("- Production /opt/cloud-guardian is read-only; do not read /root or production secrets.\n")
+	b.WriteString("- Changes to workspace source are not auto-deployed; state what must be deployed.\n")
+	b.WriteString("\n## Response style\n")
+	b.WriteString("- Work autonomously; use the tools. Final report max 6 lines: result, key evidence, next action.\n")
+	b.WriteString("- Respect explicit constraints in the goal (e.g. do not change/restart a server/front).\n")
+	b.WriteString("- Never claim success without a tool result. Report real errors.\n")
+	return b.String()
+}
+
+func (r *Router) runRepairWorker(w repairWorker) {
+	ctx, cancel := context.WithTimeout(context.Background(), repairAgentTimeout)
+	defer cancel()
+	repairWorkerMu.Lock()
+	repairWorkerCancels[w.ID] = cancel
+	repairWorkerRunning[w.ID] = true
+	repairWorkerMu.Unlock()
+	defer func() {
+		repairWorkerMu.Lock()
+		delete(repairWorkerCancels, w.ID)
+		delete(repairWorkerRunning, w.ID)
+		repairWorkerMu.Unlock()
+	}()
+
+	c := r.repairCfg()
+	if repairModelOK(strings.TrimSpace(w.Model)) {
+		c.DSModel = strings.TrimSpace(w.Model)
+	}
+	token := r.issueWorkerToken(30 * time.Minute)
+	ctxText := r.repairWorkerContext(c, w, token)
+	ctxPath := filepath.Join(repairAgentWorkspace, "WORKER-"+w.ID+".md")
+	if err := os.WriteFile(ctxPath, []byte(ctxText), 0o644); err != nil {
+		r.finishRepairWorker(w, 0, "", nil, fmt.Errorf("نوشتن context ناموفق: %w", err))
+		return
+	}
+	session := r.repairAgentSessionGet("worker", w.ID)
+	start := time.Now()
+	r.repairWorkerUpdate(w.ID, func(x *repairWorker) {
+		x.LastRun = start.Unix()
+		x.LastStatus = "running"
+		x.Progress = 5
+		x.Steps = []string{"در حال آماده‌سازی ورکر…"}
+		x.LastError = ""
+		x.LastReply = ""
+	})
+	onStep := func(label string, p int) {
+		r.repairWorkerUpdate(w.ID, func(x *repairWorker) {
+			if label != "" {
+				x.Steps = append(x.Steps, label)
+				if len(x.Steps) > 40 {
+					x.Steps = x.Steps[len(x.Steps)-40:]
+				}
+			}
+			if p > x.Progress {
+				x.Progress = p
+			}
+		})
+	}
+	reply, steps, newSession, err := r.runOpenCode(ctx, c, session, ctxPath, w.Prompt, token, onStep)
+	if newSession != "" {
+		r.repairAgentSessionSet("worker", w.ID, newSession)
+	}
+	r.finishRepairWorker(w, time.Since(start), reply, steps, err)
+}
+
+func (r *Router) finishRepairWorker(w repairWorker, dur time.Duration, reply string, steps []string, err error) {
+	status := "ok"
+	errText := ""
+	if err != nil {
+		status = "error"
+		errText = truncRune(err.Error(), 500)
+	}
+	now := time.Now()
+	r.repairWorkerUpdate(w.ID, func(x *repairWorker) {
+		if x.LastStatus == "canceled" && status == "error" {
+			status = "canceled"
+		}
+		x.LastStatus = status
+		x.Progress = 100
+		x.LastError = errText
+		x.LastReply = truncRune(reply, 6000)
+		x.Steps = steps
+		x.LastDuration = int64(dur.Seconds())
+		x.LastRun = now.Unix()
+		x.NextRun = repairWorkerNext(*x, now)
+	})
+	r.repairWorkerLogAdd(w.ID, repairWorkerRun{TS: now.Unix(), Status: status, Reply: truncRune(reply, 6000), Error: errText, Steps: steps, Duration: int64(dur.Seconds())})
+	if r.Bot != nil {
+		icon := "✅"
+		if status == "error" {
+			icon = "❌"
+		} else if status == "canceled" {
+			icon = "⏹"
+		}
+		msg := fmt.Sprintf("%s ورکر «%s»\nوضعیت: %s · %ds\n%s", icon, w.Name, status, int64(dur.Seconds()), truncRune(reply, 700))
+		go r.Bot.Send(r.AdminID, msg, nil)
+	}
+}
+
+func (r *Router) WorkerTick() {
+	now := time.Now()
+	list := r.repairWorkers()
+	for i := range list {
+		w := &list[i]
+		if !w.Enabled || w.NextRun > now.Unix() {
+			continue
+		}
+		if r.repairWorkerRunningCheck(w.ID) {
+			continue
+		}
+		w.NextRun = repairWorkerNext(*w, now)
+		r.repairWorkersSave(list)
+		go r.runRepairWorker(*w)
+		return
+	}
+}
+
+func (r *Router) webRepairWorkers(w http.ResponseWriter, req *http.Request, uid int64) {
+	webOK(w, map[string]any{"workers": r.repairWorkers(), "logs": r.repairWorkerLogs()})
+}
+
+func (r *Router) webRepairWorkersSave(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in repairWorker
+	if !webDecode(w, req, &in) {
+		return
+	}
+	in.Name = strings.TrimSpace(in.Name)
+	in.Prompt = strings.TrimSpace(in.Prompt)
+	if in.Name == "" || in.Prompt == "" {
+		webErr(w, http.StatusBadRequest, "نام و پرامپت ورکر لازم است")
+		return
+	}
+	if in.Schedule != "daily" {
+		in.Schedule = "interval"
+	}
+	if in.IntervalMin <= 0 {
+		in.IntervalMin = 60
+	}
+	if in.Schedule == "daily" && !strings.Contains(in.DailyAt, ":") {
+		in.DailyAt = "09:00"
+	}
+	if in.Model != "" && !repairModelOK(in.Model) {
+		in.Model = ""
+	}
+	list := r.repairWorkers()
+	now := time.Now()
+	if strings.TrimSpace(in.ID) == "" {
+		in.ID = repairWorkerNewID()
+		in.CreatedAt = now.Unix()
+		in.NextRun = repairWorkerNext(in, now)
+		list = append(list, in)
+	} else {
+		found := false
+		for i := range list {
+			if list[i].ID == in.ID {
+				in.CreatedAt = list[i].CreatedAt
+				in.LastRun = list[i].LastRun
+				in.LastStatus = list[i].LastStatus
+				in.LastError = list[i].LastError
+				in.LastReply = list[i].LastReply
+				in.Progress = list[i].Progress
+				in.Steps = list[i].Steps
+				in.LastDuration = list[i].LastDuration
+				in.NextRun = repairWorkerNext(in, now)
+				list[i] = in
+				found = true
+				break
+			}
+		}
+		if !found {
+			webErr(w, http.StatusNotFound, "ورکر پیدا نشد")
+			return
+		}
+	}
+	r.repairWorkersSave(list)
+	webOK(w, map[string]any{"ok": true, "id": in.ID, "nextRun": in.NextRun})
+}
+
+func (r *Router) webRepairWorkersDel(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		ID string `json:"id"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	id := strings.TrimSpace(in.ID)
+	list := r.repairWorkers()
+	kept := make([]repairWorker, 0, len(list))
+	for _, x := range list {
+		if x.ID != id {
+			kept = append(kept, x)
+		}
+	}
+	r.repairWorkersSave(kept)
+	webOK(w, map[string]any{"ok": true})
+}
+
+func (r *Router) webRepairWorkersRun(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		ID string `json:"id"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	id := strings.TrimSpace(in.ID)
+	var found *repairWorker
+	for _, w := range r.repairWorkers() {
+		if w.ID == id {
+			cp := w
+			found = &cp
+			break
+		}
+	}
+	if found == nil {
+		webErr(w, http.StatusNotFound, "ورکر پیدا نشد")
+		return
+	}
+	if r.repairWorkerRunningCheck(id) {
+		webErr(w, http.StatusConflict, "این ورکر همین حالا در حال اجراست")
+		return
+	}
+	go r.runRepairWorker(*found)
+	webOK(w, map[string]any{"ok": true, "started": true})
+}
+
+func (r *Router) webRepairWorkersCancel(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		ID string `json:"id"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	if !r.repairWorkerCancel(strings.TrimSpace(in.ID)) {
+		webErr(w, http.StatusNotFound, "ورکر در حال اجرا نیست")
+		return
+	}
+	webOK(w, map[string]any{"ok": true, "status": "canceled"})
+}
