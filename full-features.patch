+// webRepairUsers powers the test-username picker: it searches the users that
+// actually exist inside one of the Pasarguard panels added under "پنل".
+func (r *Router) webRepairUsers(w http.ResponseWriter, req *http.Request, uid int64) {
+	idx, _ := strconv.Atoi(strings.TrimSpace(req.URL.Query().Get("idx")))
+	query := strings.TrimSpace(req.URL.Query().Get("q"))
+	panels := r.PanelsRaw()
+	if idx < 0 || idx >= len(panels) {
+		webErr(w, http.StatusBadRequest, "پنل پیدا نشد")
+		return
+	}
+	p := panels[idx]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	users, total, err := cli.SearchUsers(tok, query, 30)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن یوزرها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	webOK(w, map[string]any{"users": users, "total": total})
+}
