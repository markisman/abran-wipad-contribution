+func (r *Router) webRepairChatSend(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Index   int    `json:"idx"`
+		HostID  string `json:"hostId"`
+		Message string `json:"message"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	msg := strings.TrimSpace(in.Message)
+	hid := strings.TrimSpace(in.HostID)
+	if msg == "" || hid == "" {
+		webErr(w, http.StatusBadRequest, "متن یا کانفیگ خالی است")
+		return
+	}
+	panels := r.PanelsRaw()
+	if in.Index < 0 || in.Index >= len(panels) {
+		webErr(w, http.StatusBadRequest, "پنل پیدا نشد")
+		return
+	}
+	p := panels[in.Index]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	raw, err := cli.Hosts(tok)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن کانفیگ‌ها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	var host map[string]any
+	for _, hv := range raw {
+		if m, ok := hv.(map[string]any); ok && strv(m["id"]) == hid {
+			host = m
+			break
+		}
+	}
+	if host == nil {
+		webErr(w, http.StatusNotFound, "کانفیگ در پنل پیدا نشد")
+		return
+	}
+	c := r.repairCfg()
+	sys := repairChatSystem(c, in.Index, pname(p), p.URL, host)
+	if si, se := cli.System(tok); se == nil {
+		sys += fmt.Sprintf("\nاطلاعات زندهٔ پنل: نسخه %s · کاربران %d · آنلاین %d\n", si.Version, si.TotalUser, si.OnlineUsers)
+	}
+	refs := repairUserPromptRefs(c, msg)
+	chatUser := msg
+	if refs != "" {
+		chatUser = msg + "\n\n" + refs
+	}
+	// This config's own conversation is the memory of the chat. The main and
+	// shared prompts live in sys; reset deletes these rows, which is what makes
+	// "reset" start a fresh chat.
+	hist := make([]repairChatEntry, 0, 16)
+	for _, e := range r.repairChatList() {
+		if e.Kind == "manual" && e.Panel == pname(p) && e.HostID == hid {
+			hist = append(hist, e)
+		}
+	}
+	for i, j := 0, len(hist)-1; i < j; i, j = i+1, j-1 {
+		hist[i], hist[j] = hist[j], hist[i]
+	}
+	if len(hist) > 12 {
+		hist = hist[len(hist)-12:]
+	}
+	history := make([]map[string]any, 0, len(hist)*2)
+	for _, e := range hist {
+		ut := strings.TrimSpace(e.UserText)
+		if ut == "" {
+			ut = strings.TrimSpace(e.Request)
+		}
+		if e.Context != "" {
+			ut += "\n\n" + e.Context
+		}
+		if ut != "" {
+			history = append(history, map[string]any{"role": "user", "content": truncRune(ut, 8000)})
+		}
+		if strings.TrimSpace(e.Response) != "" {
+			history = append(history, map[string]any{"role": "assistant", "content": truncRune(e.Response, 4000)})
+		}
+	}
+	// Let the chat know what the automatic repair already did for this config.
+	autos := make([]repairChatEntry, 0, 5)
+	for _, e := range r.repairChatList() {
+		if e.Kind == "auto" && e.Panel == pname(p) && e.HostID == hid {
+			autos = append(autos, e)
+		}
+	}
+	for i, j := 0, len(autos)-1; i < j; i, j = i+1, j-1 {
+		autos[i], autos[j] = autos[j], autos[i]
+	}
+	if len(autos) > 5 {
+		autos = autos[len(autos)-5:]
+	}
+	for _, e := range autos {
+		txt := "اقدام خودکار"
+		if e.Action != "" {
+			txt += ": " + e.Action
+		}
+		if e.Value != "" {
+			txt += " " + e.Value
+		}
+		if e.Reason != "" {
+			txt += " — " + e.Reason
+		}
+		if txt != "اقدام خودکار" {
+			history = append(history, map[string]any{"role": "assistant", "content": txt})
+		}
+	}
+	reply, ce := r.repairChatDeepSeek(req.Context(), c, sys, history, chatUser)
+	addr := ""
+	if a := hfList(host["address"]); len(a) > 0 {
+		addr = a[0]
+	}
+	act := repairAction{}
+	if i := strings.Index(reply, "{"); i >= 0 {
+		if j := strings.LastIndex(reply, "}"); j > i {
+			var a repairAction
+			if json.Unmarshal([]byte(reply[i:j+1]), &a) == nil {
+				act = a
+			}
+		}
+	}
+	entry := repairChatEntry{
+		TS: time.Now().Unix(), Kind: "manual", Panel: pname(p),
+		HostID: strv(host["id"]), HostRemark: strv(host["remark"]), HostAddr: addr, Port: intOfAny(host["port"]),
+		Model: c.DSModel, System: truncRune(sys, 20000), Request: msg, Response: truncRune(reply, 10000), UserText: msg, Context: truncRune(refs, 20000),
+		Action: act.Action, Value: act.Value, Reason: act.Reason,
+	}
+	if ce != nil {
+		entry.Error = truncRune(ce.Error(), 300)
+	}
+	r.repairChatAdd(entry)
+	if ce != nil {
+		webErr(w, http.StatusBadGateway, "پاسخ هوش مصنوعی ناموفق: "+truncRune(ce.Error(), 120))
+		return
+	}
+	webOK(w, map[string]any{"reply": reply, "chat": entry})
+}
