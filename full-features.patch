+package router
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/aknuun/cg-server/internal/cf"
+)
+
+func (r *Router) webCfBlocks(w http.ResponseWriter, req *http.Request, uid int64) {
+	accs := r.cfAccs()
+	out := make([]map[string]any, 0, len(accs))
+	for i, a := range accs {
+		out = append(out, map[string]any{"i": i, "name": a.Name})
+	}
+	acc := 0
+	if v := strings.TrimSpace(req.URL.Query().Get("acc")); v != "" {
+		acc = atoiSafe(v)
+	}
+	zones := []cf.Zone{}
+	zerr := ""
+	if acc >= 0 && acc < len(accs) {
+		if cli, err := r.webCfClient(acc); err != nil {
+			zerr = err.Error()
+		} else if zz, err := cli.Zones(); err != nil {
+			zerr = err.Error()
+		} else {
+			zones = zz
+		}
+	}
+	token := r.cfTokenStatus(acc)
+	if zerr != "" {
+		token["ok"] = false
+		token["error"] = zerr
+	}
+	webOK(w, map[string]any{"accounts": out, "zones": zones, "error": zerr, "token": token})
+}
+func (r *Router) cfTokenStatus(acc int) map[string]any {
+	accs := r.cfAccs()
+	if acc < 0 || acc >= len(accs) {
+		return map[string]any{"ok": false, "has": false}
+	}
+	return map[string]any{"ok": true, "has": strings.TrimSpace(accs[acc].Token) != ""}
+}
+func (r *Router) webCfBlockEvents(w http.ResponseWriter, req *http.Request, uid int64) {
+	acc := atoiSafe(req.URL.Query().Get("acc"))
+	zid := strings.TrimSpace(req.URL.Query().Get("zone"))
+	ray := strings.TrimSpace(req.URL.Query().Get("ray"))
+	hours := atoiSafe(req.URL.Query().Get("hours"))
+	cli, err := r.webCfClient(acc)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if zid == "" {
+		webErr(w, http.StatusBadRequest, "zone لازم است")
+		return
+	}
+	ev, err := cli.FirewallEvents(zid, ray, hours, 200)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, err.Error())
+		return
+	}
+	webOK(w, map[string]any{"events": ev})
+}
+func (r *Router) webCfBlockRules(w http.ResponseWriter, req *http.Request, uid int64) {
+	acc := atoiSafe(req.URL.Query().Get("acc"))
+	zid := strings.TrimSpace(req.URL.Query().Get("zone"))
+	cli, err := r.webCfClient(acc)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if zid == "" {
+		webErr(w, http.StatusBadRequest, "zone لازم است")
+		return
+	}
+	rules, err := cli.Rulesets(zid)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, err.Error())
+		return
+	}
+	webOK(w, map[string]any{"rules": rules})
+}
+func (r *Router) webCfBlockSkip(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Acc         int      `json:"acc"`
+		Zone        string   `json:"zone"`
+		Expression  string   `json:"expression"`
+		Description string   `json:"description"`
+		Phases      []string `json:"phases"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	in.Zone = strings.TrimSpace(in.Zone)
+	in.Expression = strings.TrimSpace(in.Expression)
+	if in.Zone == "" || in.Expression == "" {
+		webErr(w, http.StatusBadRequest, "zone و expression لازم است")
+		return
+	}
+	if len(in.Phases) == 0 {
+		in.Phases = []string{"http_response_firewall_managed"}
+	}
+	cli, err := r.webCfClient(in.Acc)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	out, err := cli.AddSkip(in.Zone, in.Expression, in.Description, in.Phases)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, err.Error())
+		return
+	}
+	zoneName := in.Zone
+	if z, err := cli.Zone(in.Zone); err == nil {
+		zoneName = strv(z["name"])
+	}
+	r.cfAuditAdd(uid, in.Acc, in.Zone, zoneName, "cfblocks_skip", in.Expression)
+	webOK(w, map[string]any{"ok": true, "result": out})
+}
+func (r *Router) webCfBlockRule(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Acc     int    `json:"acc"`
+		Zone    string `json:"zone"`
+		Ruleset string `json:"ruleset"`
+		Rule    string `json:"rule"`
+		Enabled bool   `json:"enabled"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	in.Zone = strings.TrimSpace(in.Zone)
+	in.Ruleset = strings.TrimSpace(in.Ruleset)
+	in.Rule = strings.TrimSpace(in.Rule)
+	if in.Zone == "" || in.Ruleset == "" || in.Rule == "" {
+		webErr(w, http.StatusBadRequest, "zone/ruleset/rule لازم است")
+		return
+	}
+	cli, err := r.webCfClient(in.Acc)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	if err := cli.SetRuleEnabled(in.Zone, in.Ruleset, in.Rule, in.Enabled); err != nil {
+		webErr(w, http.StatusBadGateway, err.Error())
+		return
+	}
+	zoneName := in.Zone
+	if z, err := cli.Zone(in.Zone); err == nil {
+		zoneName = strv(z["name"])
+	}
+	r.cfAuditAdd(uid, in.Acc, in.Zone, zoneName, "cfblocks_rule", in.Rule+" enabled="+strconv.FormatBool(in.Enabled))
+	webOK(w, map[string]any{"ok": true, "enabled": in.Enabled})
+}
+func (r *Router) webCfBlockTest(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		URLs []string `json:"urls"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	if len(in.URLs) == 0 {
+		webErr(w, http.StatusBadRequest, "حداقل یک URL لازم است")
+		return
+	}
+	if len(in.URLs) > 6 {
+		in.URLs = in.URLs[:6]
+	}
+	cli, err := r.webCfClient(0)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	ctx, cancel := context.WithTimeout(req.Context(), 40*time.Second)
+	defer cancel()
+	out := make([]cf.WSTestResult, 0, len(in.URLs))
+	for _, u := range in.URLs {
+		out = append(out, cli.TestWebSocket(ctx, u))
+	}
+	webOK(w, map[string]any{"results": out})
+}
