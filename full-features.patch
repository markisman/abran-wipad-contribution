+// webRepairTest runs a real health/throughput test for one host using the
+// panel test user's subscription link. It is intentionally read-only: it only
+// records latency/speed state; it never edits the panel.
+func (r *Router) webRepairTest(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Index  int    `json:"idx"`
+		HostID string `json:"hostId"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	hid := strings.TrimSpace(in.HostID)
+	panels := r.PanelsRaw()
+	if in.Index < 0 || in.Index >= len(panels) || hid == "" {
+		webErr(w, http.StatusBadRequest, "پنل یا کانفیگ پیدا نشد")
+		return
+	}
+	p := panels[in.Index]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	raw, err := cli.Hosts(tok)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن کانفیگ‌ها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	var host map[string]any
+	for _, hv := range raw {
+		if m, ok := hv.(map[string]any); ok && strv(m["id"]) == hid {
+			host = m
+			break
+		}
+	}
+	if host == nil {
+		webErr(w, http.StatusNotFound, "کانفیگ در پنل پیدا نشد")
+		return
+	}
+	c := r.repairCfg()
+	uname := strings.TrimSpace(c.TestUsers[repairPanelKey(p.URL)])
+	if uname == "" {
+		uname = strings.TrimSpace(c.TestUsers[strconv.Itoa(in.Index)])
+	}
+	links := []cfgLink{}
+	if uname != "" {
+		if uo := cli.User(tok, uname); uo != nil {
+			if sub := strv(uo["subscription_url"]); sub != "" {
+				if raws, se := cfgSubLinks(req.Context(), sub); se == nil {
+					for _, rawLink := range raws {
+						if l, pe := cfgParseLink(rawLink); pe == nil {
+							links = append(links, l)
+						}
+					}
+				}
+			}
+		}
+	}
+	link, ok := repairMatchLink(host, links)
+	if !ok {
+		webErr(w, http.StatusConflict, "لینک تست برای این کانفیگ پیدا نشد (یوزر تست/سابسکریپشن را چک کن)")
+		return
+	}
+	ctx, cancel := context.WithTimeout(req.Context(), 70*time.Second)
+	defer cancel()
+	res := r.cfgTestOne(ctx, link, cfgOpts{Samples: 2, Timeout: 10 * time.Second})
+	mbps := 0.0
+	if c.ThroughputBytes > 0 && res.Verdict != "fail" && ctx.Err() == nil {
+		tctx, tcancel := context.WithTimeout(req.Context(), 30*time.Second)
+		if v, te := repairThroughput(tctx, link, c.ThroughputBytes); te == nil {
+			mbps = v
+		}
+		tcancel()
+	}
+	st := r.repairStateLoad()
+	key := strconv.Itoa(in.Index) + ":" + hid
+	s := st[key]
+	s.LastCheck = time.Now().Unix()
+	s.Latency = res.MedianMS
+	if res.Verdict == "fail" {
+		s.Fails++
+	} else {
+		s.Fails = 0
+	}
+	if mbps > 0 {
+		s.Mbps = mbps
+		s.ThruTS = time.Now().Unix()
+	}
+	st[key] = s
+	r.repairStateSave(st)
+	webOK(w, map[string]any{
+		"host":     repairAgentHostAddr(host),
+		"remark":   strv(host["remark"]),
+		"testUser": uname,
+		"verdict":  res.Verdict,
+		"medianMs": res.MedianMS,
+		"loss":     res.Loss,
+		"mbps":     mbps,
+		"baseline": repairMedian(s.Base),
+		"at":       time.Now().Unix(),
+	})
+}
