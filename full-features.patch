+// webRepairHost toggles one host's is_disabled flag on the panel and mirrors it
+// into the persisted HOST list.
+func (r *Router) webRepairHost(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Index    int    `json:"idx"`
+		ID       string `json:"id"`
+		Disabled bool   `json:"disabled"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	id := strings.TrimSpace(in.ID)
+	panels := r.PanelsRaw()
+	if in.Index < 0 || in.Index >= len(panels) || id == "" {
+		webErr(w, http.StatusBadRequest, "پنل یا کانفیگ پیدا نشد")
+		return
+	}
+	p := panels[in.Index]
+	cli := p.Client()
+	tok, err := repairCachedToken(p.URL+"|"+p.Username, cli.Login)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "ورود به پنل ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	raw, err := cli.Hosts(tok)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "خواندن کانفیگ‌ها ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	var target map[string]any
+	for _, hv := range raw {
+		if m, ok := hv.(map[string]any); ok && strv(m["id"]) == id {
+			target = m
+			break
+		}
+	}
+	if target == nil {
+		webErr(w, http.StatusNotFound, "کانفیگ در پنل پیدا نشد")
+		return
+	}
+	oldDisabled := boolVal(target["is_disabled"])
+	target["is_disabled"] = in.Disabled
+	if err := cli.PutHost(tok, id, target); err != nil {
+		webErr(w, http.StatusBadGateway, "تغییر وضعیت ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	list := r.repairHosts()
+	for _, h := range list {
+		if strv(h["panelUrl"]) == p.URL && strv(h["id"]) == id {
+			h["disabled"] = in.Disabled
+		}
+	}
+	r.Store.PutJSON(repairHostsKey, list, 0)
+	addr := ""
+	if a := hfList(target["address"]); len(a) > 0 {
+		addr = a[0]
+	}
+	act := "enable"
+	if in.Disabled {
+		act = "disable"
+	}
+	r.repairLogAdd(repairLogEntry{
+		TS: time.Now().Unix(), Key: repairHostKey(p.URL, id), Panel: pname(p),
+		Host: addr, Remark: strv(target["remark"]), Action: act, Result: "manual",
+		Detail: fmt.Sprintf("is_disabled: %v → %v (تغییر دستی)", oldDisabled, in.Disabled),
+	})
+	webOK(w, map[string]any{"ok": true, "disabled": in.Disabled})
+}
+
+func (r *Router) webRepairTestKey(w http.ResponseWriter, req *http.Request, uid int64) {
+	var in struct {
+		Key string `json:"key"`
+	}
+	if !webDecode(w, req, &in) {
+		return
+	}
+	c := r.repairCfg()
+	key := strings.TrimSpace(in.Key)
+	if key == "" {
+		key = strings.TrimSpace(c.DSKey)
+	}
+	if key == "" {
+		webErr(w, http.StatusBadRequest, "کلید API خالی است")
+		return
+	}
+	base := strings.TrimRight(c.DSBase, "/")
+	if base == "" {
+		base = "https://api.deepseek.com"
+	}
+	ctx, cancel := context.WithTimeout(req.Context(), 20*time.Second)
+	defer cancel()
+	hreq, err := http.NewRequestWithContext(ctx, http.MethodGet, base+"/models", nil)
+	if err != nil {
+		webErr(w, http.StatusBadRequest, err.Error())
+		return
+	}
+	hreq.Header.Set("Authorization", "Bearer "+key)
+	resp, err := (&http.Client{Timeout: 20 * time.Second}).Do(hreq)
+	if err != nil {
+		webErr(w, http.StatusBadGateway, "اتصال به DeepSeek ناموفق: "+truncRune(err.Error(), 120))
+		return
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(io.LimitReader(resp.Body, 4096))
+	if resp.StatusCode != http.StatusOK {
+		webErr(w, http.StatusBadRequest, fmt.Sprintf("DeepSeek پاسخ %d داد: %s", resp.StatusCode, truncRune(strings.TrimSpace(string(b)), 180)))
+		return
+	}
+	webOK(w, map[string]any{"ok": true})
+}
+
+func (r *Router) webRepairPage(w http.ResponseWriter, req *http.Request) {
+	b, err := webuiFS.ReadFile("webui/repair/index.html")
+	if err != nil {
+		http.NotFound(w, req)
+		return
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Cache-Control", "no-store, max-age=0")
+	_, _ = w.Write(b)
+}
