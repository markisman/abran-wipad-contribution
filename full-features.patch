+func repairChatSystem(c repairCfg, pi int, panelName, panelURL string, h map[string]any) string {
+	var b strings.Builder
+	b.WriteString("تو دستیار هوش مصنوعی «نگهبان ابری» هستی. فارسی، کوتاه و عملی جواب بده و اگر اطلاعات کافی نیست صادقانه بگو.\n")
+	b.WriteString("پنل: " + panelName + "\n")
+	b.WriteString("کانفیگ: " + strv(h["remark"]) + "\n")
+	b.WriteString(fmt.Sprintf("آدرس: %s · پورت: %d · SNI: %s · امنیت: %s · Inbound: %s · غیرفعال: %v\n",
+		strings.Join(hfList(h["address"]), ", "), intOfAny(h["port"]), strings.Join(hfList(h["sni"]), ", "),
+		strv(h["security"]), strv(h["inbound_tag"]), h["is_disabled"]))
+	if strings.TrimSpace(c.Prompt) != "" {
+		b.WriteString("\nقواعد کلی:\n" + c.Prompt + "\n")
+	}
+	shared := []string{}
+	if len(c.HostPromptAllList) > 0 {
+		for _, x := range c.HostPromptAllList {
+			if strings.TrimSpace(x) != "" {
+				shared = append(shared, x)
+			}
+		}
+	} else if strings.TrimSpace(c.HostPromptAll) != "" {
+		shared = append(shared, c.HostPromptAll)
+	}
+	if len(shared) > 0 {
+		b.WriteString("\nپرامپت‌های مشترک:\n" + strings.Join(shared, "\n\n") + "\n")
+	}
+	key := repairHostKey(panelURL, strv(h["id"]))
+	oldKey := fmt.Sprintf("%d:%s", pi, strv(h["id"]))
+	prompts := c.HostPromptList[key]
+	if len(prompts) == 0 {
+		prompts = c.HostPromptList[oldKey]
+	}
+	own := []string{}
+	for _, x := range prompts {
+		if strings.TrimSpace(x) != "" {
+			own = append(own, x)
+		}
+	}
+	if len(own) == 0 {
+		single := strings.TrimSpace(c.HostPrompts[key])
+		if single == "" {
+			single = strings.TrimSpace(c.HostPrompts[oldKey])
+		}
+		if single != "" {
+			own = append(own, single)
+		}
+	}
+	if len(own) > 0 {
+		b.WriteString("\nپرامپت‌های این کانفیگ:\n" + strings.Join(own, "\n\n") + "\n")
+	}
+	body := repairAppendPromptRefs(c, b.String(), key)
+	b.Reset()
+	b.WriteString(body)
+	b.WriteString("\nاگر در پیام کاربر شناسه‌ای مثل #G یا #P8883.1 دیدی، متن پرامپت ارجاع‌شده در ادامهٔ همان پیام آمده است؛ از آن استفاده کن.\n")
+	b.WriteString("\nقاعدهٔ این چت: فقط به فارسی و متنی پاسخ بده؛ خروجی JSON نده. قاعدهٔ JSON مربوط به تصمیم‌گیری خودکار است، نه این گفت‌وگو. اگر کاربر دستور اجرایی خواست، فقط پیشنهادت را توضیح بده.\n")
+	return b.String()
+}
