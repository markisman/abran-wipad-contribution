+var repairBusy atomic.Bool
+
+// Panel logins are only needed to list usernames while someone types in the
+// repair page. Cache the token briefly so a search box does not hammer the
+// panel's /api/admin/token on every keystroke.
+var (
+	repairTokMu sync.Mutex
+	repairToks  = map[string]repairToken{}
+)
+
+type repairToken struct {
+	tok string
+	exp time.Time
+}
+
+func repairCachedToken(key string, login func() (string, error)) (string, error) {
+	now := time.Now()
+	repairTokMu.Lock()
+	if t, ok := repairToks[key]; ok && now.Before(t.exp) {
+		repairTokMu.Unlock()
+		return t.tok, nil
+	}
+	repairTokMu.Unlock()
+	tok, err := login()
+	if err != nil {
+		return "", err
+	}
+	repairTokMu.Lock()
+	repairToks[key] = repairToken{tok: tok, exp: now.Add(10 * time.Minute)}
+	repairTokMu.Unlock()
+	return tok, nil
+}
+
+func repairModelOK(m string) bool {
+	return m == "deepseek-flash" || m == "deepseek-v4-pro"
+}
+
+// Panel-URL keys are stable when panels are added, removed or reordered;
+// numeric-index keys are kept as a fallback for old saved configs.
+func repairPanelKey(url string) string { return strings.TrimRight(strings.TrimSpace(url), "/") }
+
+func repairHostKey(url, id string) string {
+	return repairPanelKey(url) + "#" + strings.TrimSpace(id)
+}
+
+// Every prompt gets a short stable tag. A prompt may mention another tag
+// (#P8868, @P8868 or [[P8868]]) and the referenced prompt is attached to the
+// DeepSeek system message at send time. Shared (S1...) and global (G) prompts
+// are always present, so only other configs' prompts need expanding.
+func repairIDSlug(s string) string {
+	var b strings.Builder
+	for _, r := range s {
+		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9') || r == '_' || r == '-' {
+			b.WriteRune(r)
+		}
+	}
+	if b.Len() == 0 {
+		return "X"
+	}
+	return b.String()
+}
+
+func repairUniqueID(base string, used map[string]bool) string {
+	if !used[base] {
+		used[base] = true
+		return base
+	}
+	for i := 2; ; i++ {
+		id := fmt.Sprintf("%s-%d", base, i)
+		if !used[id] {
+			used[id] = true
+			return id
+		}
+	}
+}
+
+func repairEnsurePromptIDs(c *repairCfg) {
+	if c.PromptIDs == nil {
+		c.PromptIDs = map[string]string{}
+	}
+	if c.HostPromptItemIDs == nil {
+		c.HostPromptItemIDs = map[string][]string{}
+	}
+	used := map[string]bool{}
+	for _, id := range c.PromptIDs {
+		if id != "" {
+			used[id] = true
+		}
+	}
+	keys := make([]string, 0, len(c.HostPromptList)+len(c.HostPrompts))
+	seen := map[string]bool{}
+	for k := range c.HostPromptList {
+		keys = append(keys, k)
+		seen[k] = true
+	}
+	for k := range c.HostPrompts {
+		if !seen[k] {
+			keys = append(keys, k)
+		}
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		if c.PromptIDs[k] != "" {
+			continue
+		}
+		host := k
+		if i := strings.LastIndex(k, "#"); i >= 0 {
+			host = k[i+1:]
+		}
+		c.PromptIDs[k] = repairUniqueID("P"+repairIDSlug(host), used)
+	}
+	// Each prompt item inside a config gets its own stable tag (P8883.1,
+	// P8883.2, ...) so one prompt can reference a single prompt of another
+	// config, not only the whole config.
+	for _, k := range keys {
+		list := c.HostPromptList[k]
+		if len(list) == 0 {
+			continue
+		}
+		items := c.HostPromptItemIDs[k]
+		for len(items) < len(list) {
+			items = append(items, "")
+		}
+		base := c.PromptIDs[k]
+		if base == "" {
+			host := k
+			if i := strings.LastIndex(k, "#"); i >= 0 {
+				host = k[i+1:]
+			}
+			base = "P" + repairIDSlug(host)
+		}
+		for i := range list {
+			if items[i] == "" {
+				items[i] = repairUniqueID(base+"."+strconv.Itoa(i+1), used)
+			} else {
+				used[items[i]] = true
+			}
+		}
+		c.HostPromptItemIDs[k] = items[:len(list)]
+	}
+	if c.PromptIDs["global"] == "" {
+		c.PromptIDs["global"] = repairUniqueID("G", used)
+	}
+	for i := range c.HostPromptAllList {
+		k := "shared:" + strconv.Itoa(i)
+		if c.PromptIDs[k] == "" {
+			c.PromptIDs[k] = "S" + strconv.Itoa(i+1)
+		}
+	}
+	if len(c.HostPromptAllList) == 0 && strings.TrimSpace(c.HostPromptAll) != "" && c.PromptIDs["shared:0"] == "" {
+		c.PromptIDs["shared:0"] = "S1"
+	}
+}
+
+type repairPromptDoc struct {
+	ID    string
+	Key   string
+	Label string
+	Text  string
+}
+
+func repairPromptDocs(c repairCfg) []repairPromptDoc {
+	out := make([]repairPromptDoc, 0, 8)
+	gid := c.PromptIDs["global"]
+	if gid == "" {
+		gid = "G"
+	}
+	out = append(out, repairPromptDoc{ID: gid, Key: "global", Label: "پرامپت سراسری", Text: c.Prompt})
+	keys := make([]string, 0, len(c.HostPromptList)+len(c.HostPrompts))
+	seen := map[string]bool{}
+	for k := range c.HostPromptList {
+		keys = append(keys, k)
+		seen[k] = true
+	}
+	for k := range c.HostPrompts {
+		if !seen[k] {
+			keys = append(keys, k)
+		}
+	}
+	sort.Strings(keys)
+	for _, k := range keys {
+		text := strings.Join(c.HostPromptList[k], "\n\n")
+		if strings.TrimSpace(text) == "" {
+			text = c.HostPrompts[k]
+		}
+		if strings.TrimSpace(text) == "" {
+			continue
+		}
+		host := k
+		if i := strings.LastIndex(k, "#"); i >= 0 {
+			host = k[i+1:]
+		}
+		id := c.PromptIDs[k]
+		if id == "" {
+			id = "P" + repairIDSlug(host)
+		}
+		out = append(out, repairPromptDoc{ID: id, Key: k, Label: "پرامپت‌های کانفیگ " + host, Text: text})
+		items := c.HostPromptItemIDs[k]
+		for i, item := range c.HostPromptList[k] {
+			if strings.TrimSpace(item) == "" {
+				continue
+			}
+			itemID := ""
+			if i < len(items) {
+				itemID = items[i]
+			}
+			if itemID == "" {
+				itemID = id + "." + strconv.Itoa(i+1)
+			}
+			out = append(out, repairPromptDoc{ID: itemID, Key: k + "::" + strconv.Itoa(i), Label: fmt.Sprintf("پرامپت %d کانفیگ %s", i+1, host), Text: item})
+		}
+	}
+	if len(c.HostPromptAllList) > 0 {
+		for i, x := range c.HostPromptAllList {
+			if strings.TrimSpace(x) == "" {
+				continue
+			}
+			k := "shared:" + strconv.Itoa(i)
+			id := c.PromptIDs[k]
+			if id == "" {
+				id = "S" + strconv.Itoa(i+1)
+			}
+			out = append(out, repairPromptDoc{ID: id, Key: k, Label: fmt.Sprintf("پرامپت مشترک %d", i+1), Text: x})
+		}
+	} else if strings.TrimSpace(c.HostPromptAll) != "" {
+		id := c.PromptIDs["shared:0"]
+		if id == "" {
+			id = "S1"
+		}
+		out = append(out, repairPromptDoc{ID: id, Key: "shared:0", Label: "پرامپت مشترک", Text: c.HostPromptAll})
+	}
+	return out
+}
+
+var repairRefRe = regexp.MustCompile(`(?:#|@)([A-Za-z0-9_.-]{1,32})|\[\[([A-Za-z0-9_.-]{1,32})\]\]`)
+
+func repairRefIDs(text string) []string {
+	out := make([]string, 0, 4)
+	seen := map[string]bool{}
+	for _, m := range repairRefRe.FindAllStringSubmatch(text, -1) {
+		id := m[1]
+		if id == "" {
+			id = m[2]
+		}
+		id = strings.TrimRight(id, ".-")
+		if id != "" && !seen[id] {
+			seen[id] = true
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+func repairAppendPromptRefs(c repairCfg, base, selfKey string) string {
+	docs := repairPromptDocs(c)
+	byID := map[string]repairPromptDoc{}
+	for _, d := range docs {
+		if strings.TrimSpace(d.Text) != "" {
+			byID[strings.ToLower(d.ID)] = d
+		}
+	}
+	visited := map[string]bool{}
+	if selfKey != "" {
+		visited[selfKey] = true
+		prefix := selfKey + "::"
+		for _, d := range docs {
+			if strings.HasPrefix(d.Key, prefix) {
+				visited[d.Key] = true
+			}
+		}
+	}
+	for _, d := range docs {
+		if d.Key == "global" || strings.HasPrefix(d.Key, "shared:") {
+			visited[d.Key] = true
+		}
+	}
+	add := make([]string, 0, 3)
+	var walk func(string, int)
+	walk = func(text string, depth int) {
+		if depth >= 4 {
+			return
+		}
+		for _, id := range repairRefIDs(text) {
+			d, ok := byID[strings.ToLower(id)]
+			if !ok || visited[d.Key] {
+				continue
+			}
+			visited[d.Key] = true
+			add = append(add, "["+d.ID+"] "+d.Label+":\n"+d.Text)
+			walk(d.Text, depth+1)
+		}
+	}
+	walk(base, 0)
+	if len(add) == 0 {
+		return base
+	}
+	return base + "\n\n=== پرامپت‌های ارجاع‌شده ===\n" + strings.Join(add, "\n\n") + "\n=== پایان پرامپت‌های ارجاع‌شده ==="
+}
+
+// repairUserPromptRefs expands tags written in a chat message. Unlike the
+// system prompt, the chat message can reference the global/shared prompts too
+// (they are already in sys, but the user explicitly asked for that tag and the
+// model needs the mapping). Cycles are still bounded.
+func repairUserPromptRefs(c repairCfg, text string) string {
+	docs := repairPromptDocs(c)
+	byID := map[string]repairPromptDoc{}
+	for _, d := range docs {
+		if strings.TrimSpace(d.Text) != "" {
+			byID[strings.ToLower(d.ID)] = d
+		}
+	}
+	visited := map[string]bool{}
+	add := make([]string, 0, 3)
+	var walk func(string, int)
+	walk = func(t string, depth int) {
+		if depth >= 4 {
+			return
+		}
+		for _, id := range repairRefIDs(t) {
+			d, ok := byID[strings.ToLower(id)]
+			if !ok || visited[d.Key] {
+				continue
+			}
+			visited[d.Key] = true
+			add = append(add, "["+d.ID+"] "+d.Label+":\n"+d.Text)
+			walk(d.Text, depth+1)
+		}
+	}
+	walk(text, 0)
+	if len(add) == 0 {
+		return ""
+	}
+	return "=== ارجاع‌های پیام شما ===\n" + strings.Join(add, "\n\n") + "\n=== پایان ارجاع‌ها ==="
+}
+
+func (r *Router) repairCfg() repairCfg {
+	c := repairCfg{
+		IntervalMin: 5, DSBase: "https://api.deepseek.com", DSModel: "deepseek-flash",
+		Prompt: repairDefPrompt, PromptIDs: map[string]string{}, TestUsers: map[string]string{}, HostPrompts: map[string]string{}, HostPromptList: map[string][]string{}, HostPromptItemIDs: map[string][]string{},
+		MaxLatencyMs: 1500, DropPct: 40, ThroughputBytes: 1000000, ThroughputEveryMin: 30, MaxActionsPerRun: 3,
+	}
+	var saved repairCfg
+	if r.Store.GetJSON(repairCfgKey, &saved) {
+		if saved.IntervalMin > 0 {
+			c.IntervalMin = saved.IntervalMin
+		}
+		if saved.DSBase != "" {
+			c.DSBase = saved.DSBase
+		}
+		if repairModelOK(saved.DSModel) {
+			c.DSModel = saved.DSModel
+		}
+		if saved.Prompt != "" {
+			c.Prompt = saved.Prompt
+		}
+		if saved.PromptIDs != nil {
+			c.PromptIDs = saved.PromptIDs
+		}
+		if saved.TestUsers != nil {
+			c.TestUsers = saved.TestUsers
+		}
+		if saved.HostPrompts != nil {
+			c.HostPrompts = saved.HostPrompts
+		}
+		if saved.HostPromptList != nil {
+			c.HostPromptList = saved.HostPromptList
+		}
+		if saved.HostPromptItemIDs != nil {
+			c.HostPromptItemIDs = saved.HostPromptItemIDs
+		}
+		c.HostPromptAll = saved.HostPromptAll
+		c.HostPromptAllList = saved.HostPromptAllList
+		c.Enabled, c.Auto = saved.Enabled, saved.Auto
+		c.DSKey = saved.DSKey
+		if saved.MaxLatencyMs > 0 {
+			c.MaxLatencyMs = saved.MaxLatencyMs
+		}
+		if saved.DropPct > 0 {
+			c.DropPct = saved.DropPct
+		}
+		if saved.MinMbps > 0 {
+			c.MinMbps = saved.MinMbps
+		}
+		if saved.ThroughputEveryMin > 0 {
+			c.ThroughputEveryMin = saved.ThroughputEveryMin
+		}
+		c.ThroughputBytes = saved.ThroughputBytes
+		if saved.MaxActionsPerRun > 0 {
+			c.MaxActionsPerRun = saved.MaxActionsPerRun
+		}
+	}
+	// Move old index-based keys (0 / "0:id") to stable panel-URL keys so
+	// prompts and test users survive panel reordering or deletion.
+	for i, p := range r.PanelsRaw() {
+		pk := repairPanelKey(p.URL)
+		old := strconv.Itoa(i)
+		if v, ok := c.TestUsers[old]; ok && strings.TrimSpace(v) != "" {
+			if _, exists := c.TestUsers[pk]; !exists {
+				c.TestUsers[pk] = v
+			}
+		}
+		delete(c.TestUsers, old)
+		prefix := old + ":"
+		for k, v := range c.HostPrompts {
+			if strings.HasPrefix(k, prefix) {
+				nk := repairHostKey(p.URL, strings.TrimPrefix(k, prefix))
+				if _, ok := c.HostPrompts[nk]; !ok {
+					c.HostPrompts[nk] = v
+				}
+				delete(c.HostPrompts, k)
+			}
+		}
+		for k, v := range c.HostPromptList {
+			if strings.HasPrefix(k, prefix) {
+				nk := repairHostKey(p.URL, strings.TrimPrefix(k, prefix))
+				if _, ok := c.HostPromptList[nk]; !ok {
+					c.HostPromptList[nk] = v
+				}
+				delete(c.HostPromptList, k)
+			}
+		}
+	}
+	repairEnsurePromptIDs(&c)
+	return c
+}
