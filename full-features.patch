+// repairSyncHostCard mirrors a change made through the panel API back into the
+// persisted HOST card, so the HOST section is a live mirror instead of a stale
+// snapshot after an automatic repair.
+func (r *Router) repairSyncHostCard(panelURL, id string, h map[string]any) {
+	if h == nil {
+		return
+	}
+	list := r.repairHosts()
+	urlKey := repairPanelKey(panelURL)
+	changed := false
+	for _, c := range list {
+		if repairPanelKey(strv(c["panelUrl"])) != urlKey || strv(c["id"]) != strings.TrimSpace(id) {
+			continue
+		}
+		c["address"] = hfList(h["address"])
+		c["port"] = h["port"]
+		c["sni"] = hfList(h["sni"])
+		c["host"] = hfList(h["host"])
+		c["security"] = strv(h["security"])
+		c["path"] = strv(h["path"])
+		c["inbound_tag"] = strv(h["inbound_tag"])
+		c["disabled"] = boolVal(h["is_disabled"])
+		changed = true
+	}
+	if changed {
+		r.Store.PutJSON(repairHostsKey, list, 0)
+	}
+}
