+func (r *Router) repairRun(c repairCfg) {
+	if ok, _ := cfgEngineInfo(); !ok {
+		ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+		_ = cfgInstallEngine(ctx)
+		cancel()
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Minute)
+	defer cancel()
+	panels := r.PanelsRaw()
+	state := r.repairStateLoad()
+	actions := 0
+	for pi, p := range panels {
+		cli := p.Client()
+		tok, err := cli.Login()
+		if err != nil {
+			continue
+		}
+		rawHosts, err := cli.Hosts(tok)
+		if err != nil {
+			continue
+		}
+		var hosts []map[string]any
+		for _, hv := range rawHosts {
+			if m, ok := hv.(map[string]any); ok {
+				hosts = append(hosts, m)
+			}
+		}
+		var links []cfgLink
+		uname := strings.TrimSpace(c.TestUsers[repairPanelKey(p.URL)])
+		if uname == "" {
+			uname = strings.TrimSpace(c.TestUsers[strconv.Itoa(pi)])
+		}
+		if uname != "" {
+			if uo := cli.User(tok, uname); uo != nil {
+				if sub := strv(uo["subscription_url"]); sub != "" {
+					if raws, se := cfgSubLinks(ctx, sub); se == nil {
+						for _, raw := range raws {
+							if l, pe := cfgParseLink(raw); pe == nil {
+								links = append(links, l)
+							}
+						}
+					}
+				}
+			}
+		}
+		for _, h := range hosts {
+			if ctx.Err() != nil {
+				break
+			}
+			id := strv(h["id"])
+			key := strconv.Itoa(pi) + ":" + id
+			pkey := repairHostKey(p.URL, id)
+			link, ok := repairMatchLink(h, links)
+			st := state[key]
+			if !ok {
+				st.NoLink = true
+				st.LastCheck = time.Now().Unix()
+				state[key] = st
+				continue
+			}
+			st.NoLink = false
+			res := r.cfgTestOne(ctx, link, cfgOpts{Samples: 3, Timeout: 15 * time.Second})
+			st.LastCheck = time.Now().Unix()
+			st.Latency = res.MedianMS
+			st.Fails = 0
+			if res.Verdict == "fail" {
+				st.Fails++
+			}
+			mbps := 0.0
+			now := time.Now().Unix()
+			if c.ThroughputBytes > 0 && (st.ThruTS == 0 || now-st.ThruTS >= int64(c.ThroughputEveryMin)*60) {
+				if v, te := repairThroughput(ctx, link, c.ThroughputBytes); te == nil {
+					mbps = v
+					st.Mbps = v
+					st.ThruTS = now
+				}
+			} else {
+				mbps = st.Mbps
+			}
+			reason := ""
+			base := repairMedian(st.Base)
+			if st.Fails >= 2 {
+				reason = "fail"
+			}
+			if reason == "" && c.MaxLatencyMs > 0 && res.MedianMS > c.MaxLatencyMs {
+				reason = "latency"
+			}
+			if reason == "" && mbps > 0 && c.MinMbps > 0 && mbps < c.MinMbps {
+				reason = "low_speed"
+			}
+			if reason == "" && mbps > 0 && base > 0 && mbps < base*(1-c.DropPct/100) {
+				reason = "drop"
+			}
+			if reason == "" && res.Verdict != "fail" && mbps > 0 {
+				st.Base = append(st.Base, mbps)
+				if len(st.Base) > 5 {
+					st.Base = st.Base[len(st.Base)-5:]
+				}
+			}
+			state[key] = st
+			if reason == "" || !c.Auto || strings.TrimSpace(c.DSKey) == "" || actions >= c.MaxActionsPerRun {
+				continue
+			}
+			parts := make([]string, 0, 4)
+			if len(c.HostPromptAllList) > 0 {
+				for _, p := range c.HostPromptAllList {
+					if strings.TrimSpace(p) != "" {
+						parts = append(parts, p)
+					}
+				}
+			} else if strings.TrimSpace(c.HostPromptAll) != "" {
+				parts = append(parts, c.HostPromptAll)
+			}
+			list := c.HostPromptList[pkey]
+			if len(list) == 0 {
+				list = c.HostPromptList[key]
+			}
+			if len(list) > 0 {
+				for _, p := range list {
+					if strings.TrimSpace(p) != "" {
+						parts = append(parts, p)
+					}
+				}
+			} else if p := strings.TrimSpace(c.HostPrompts[pkey]); p != "" {
+				parts = append(parts, p)
+			} else if p := strings.TrimSpace(c.HostPrompts[key]); p != "" {
+				parts = append(parts, p)
+			}
+			hp := strings.Join(parts, "\n\n")
+			act, ae := r.repairAskDeepSeek(ctx, c, h, hosts, res, mbps, base, reason, hp, pname(p), pkey)
+			if ae != nil || act.Action == "" || act.Action == "noop" {
+				continue
+			}
+			before := repairDeepCopy(h)
+			detail := r.repairChangeDetail(act, before, h)
+			if err := r.repairApply(ctx, tok, cli, h, hosts, act); err != nil {
+				r.repairLogAdd(repairLogEntry{TS: time.Now().Unix(), Key: key, Panel: pname(p), Host: strv(h["address"]), Remark: strv(h["remark"]), Action: act.Action, Value: act.Value, Reason: act.Reason, Result: "apply_failed: " + truncRune(err.Error(), 120), Detail: detail, Latency: res.MedianMS, Mbps: mbps, Baseline: base})
+				continue
+			}
+			actions++
+			time.Sleep(5 * time.Second)
+			nres := r.cfgTestOne(ctx, link, cfgOpts{Samples: 2, Timeout: 12 * time.Second})
+			result := "ok"
+			if act.Action != "disable" && nres.Verdict == "fail" {
+				if rb := r.repairRollback(tok, cli, before); rb == nil {
+					result = "rolled_back"
+				} else {
+					result = "rollback_failed"
+				}
+			}
+			syncH := h
+			if result == "rolled_back" {
+				syncH = before
+			}
+			r.repairSyncHostCard(p.URL, strv(h["id"]), syncH)
+			st.LastAction = act.Action + " " + act.Value
+			st.LastActionTS = time.Now().Unix()
+			state[key] = st
+			r.repairLogAdd(repairLogEntry{TS: time.Now().Unix(), Key: key, Panel: pname(p), Host: strv(h["address"]), Remark: strv(h["remark"]), Action: act.Action, Value: act.Value, Reason: act.Reason, Result: result, Detail: detail, Latency: nres.MedianMS, Mbps: mbps, Baseline: base})
+			if r.Bot != nil {
+				msg := fmt.Sprintf("🛠 تعمیر خودکار\n%s (%s)\nاقدام: %s %s\nتغییر: %s\nنتیجه: %s\nعلت: %s", strv(h["remark"]), strv(h["address"]), act.Action, act.Value, detail, result, act.Reason)
+				_ = msg
+				go r.Bot.Send(r.AdminID, msg, nil)
+			}
+			r.repairStateSave(state)
+		}
+		r.repairStateSave(state)
+	}
+	r.repairStateSave(state)
+}
+
+func repairMedian(v []float64) float64 {
+	if len(v) == 0 {
+		return 0
+	}
+	x := append([]float64(nil), v...)
+	sort.Float64s(x)
+	return x[len(x)/2]
+}
+
+func repairDeepCopy(m map[string]any) map[string]any {
+	b, _ := json.Marshal(m)
+	out := map[string]any{}
+	_ = json.Unmarshal(b, &out)
+	return out
+}
+
+func repairMatchLink(h map[string]any, links []cfgLink) (cfgLink, bool) {
+	if len(links) == 0 {
+		return cfgLink{}, false
+	}
+	addrs := hfList(h["address"])
+	snis := append(hfList(h["sni"]), hfList(h["host"])...)
+	port := intOfAny(h["port"])
+	for _, l := range links {
+		for _, a := range addrs {
+			if a != "" && strings.EqualFold(l.Host, a) && (port == 0 || l.Port == port) {
+				return l, true
+			}
+		}
+	}
+	for _, l := range links {
+		for _, s := range snis {
+			if s != "" && strings.EqualFold(l.Host, s) {
+				return l, true
+			}
+		}
+	}
+	return cfgLink{}, false
+}
+
+func repairCandidates(h map[string]any, all []map[string]any) map[string][]string {
+	seen := map[string]map[string]bool{}
+	add := func(field, v string) {
+		v = strings.TrimSpace(v)
+		if v == "" {
+			return
+		}
+		if seen[field] == nil {
+			seen[field] = map[string]bool{}
+		}
+		if len(seen[field]) < 12 {
+			seen[field][v] = true
+		}
+	}
+	for _, val := range hfList(h["sni"]) {
+		add("sni", val)
+	}
+	for _, val := range hfList(h["host"]) {
+		add("host", val)
+	}
+	for _, val := range hfList(h["address"]) {
+		add("address", val)
+	}
+	add("port", strconv.Itoa(intOfAny(h["port"])))
+	for _, o := range all {
+		if strv(o["inbound_tag"]) != strv(h["inbound_tag"]) {
+			continue
+		}
+		for _, val := range hfList(o["sni"]) {
+			add("sni", val)
+		}
+		for _, val := range hfList(o["host"]) {
+			add("host", val)
+		}
+		for _, val := range hfList(o["address"]) {
+			add("address", val)
+		}
+		if p := intOfAny(o["port"]); p > 0 {
+			add("port", strconv.Itoa(p))
+		}
+	}
+	out := map[string][]string{}
+	for k, m := range seen {
+		for v := range m {
+			out[k] = append(out[k], v)
+		}
+		sort.Strings(out[k])
+	}
+	return out
+}
+
+func (r *Router) repairAskDeepSeek(ctx context.Context, c repairCfg, h map[string]any, all []map[string]any, res cfgResult, mbps, base float64, why, hostPrompt, panelName, selfKey string) (act repairAction, err error) {
+	var sys, request, response string
+	defer func() {
+		if r == nil {
+			return
+		}
+		addr := ""
+		if a := hfList(h["address"]); len(a) > 0 {
+			addr = a[0]
+		}
+		e := repairChatEntry{
+			TS: time.Now().Unix(), Kind: "auto", Panel: panelName,
+			HostID: strv(h["id"]), HostRemark: strv(h["remark"]), HostAddr: addr, Port: intOfAny(h["port"]),
+			Model: c.DSModel, Latency: res.MedianMS, Mbps: mbps, Why: why,
+			System: truncRune(sys, 20000), Request: truncRune(request, 20000), Response: truncRune(response, 10000),
+			Action: act.Action, Value: act.Value, Reason: act.Reason,
+		}
+		if err != nil {
+			e.Error = truncRune(err.Error(), 300)
+		}
+		go r.repairChatAdd(e)
+	}()
+	cands := repairCandidates(h, all)
+	sys = c.Prompt + "\n\nاقدامات مجاز: set_sni, set_host, set_address, set_port, restart_xray, disable, enable, noop. مقدار set_* فقط از candidates همان فیلد. اگر مقدار ssh_ready در host برابر false بود یا SSH برای ری‌استارت مطمئن نیست، restart_xray را انتخاب نکن."
+	if strings.TrimSpace(hostPrompt) != "" {
+		sys += "\n\nپرامپت این هاست:\n" + hostPrompt
+	}
+	sys = repairAppendPromptRefs(c, sys, selfKey)
+	addr := ""
+	if a := hfList(h["address"]); len(a) > 0 {
+		addr = a[0]
+	}
+	payload := map[string]any{
+		"host": map[string]any{
+			"remark": strv(h["remark"]), "address": hfList(h["address"]), "port": intOfAny(h["port"]),
+			"sni": hfList(h["sni"]), "host": hfList(h["host"]), "security": strv(h["security"]),
+			"inbound_tag": strv(h["inbound_tag"]), "path": strv(h["path"]), "is_disabled": h["is_disabled"],
+			"ssh_ready": r.repairSSHReady(addr),
+		},
+		"metrics":    map[string]any{"verdict": res.Verdict, "median_ms": res.MedianMS, "loss": res.Loss, "mbps": mbps, "baseline_mbps": base, "reason": why},
+		"candidates": cands,
+	}
+	jb, _ := json.Marshal(payload)
+	request = string(jb)
+	body := map[string]any{
+		"model": c.DSModel, "temperature": 0,
+		"response_format": map[string]any{"type": "json_object"},
+		"messages": []map[string]any{
+			{"role": "system", "content": sys},
+			{"role": "user", "content": string(jb)},
+		},
+	}
+	bb, _ := json.Marshal(body)
+	baseURL := strings.TrimRight(c.DSBase, "/")
+	if baseURL == "" {
+		baseURL = "https://api.deepseek.com"
+	}
+	req, e := http.NewRequestWithContext(ctx, http.MethodPost, baseURL+"/chat/completions", bytes.NewReader(bb))
+	if e != nil {
+		return repairAction{}, e
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+c.DSKey)
+	hc := &http.Client{Timeout: 45 * time.Second}
+	resp, e := hc.Do(req)
+	if e != nil {
+		return repairAction{}, e
+	}
+	defer resp.Body.Close()
+	rb, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	response = strings.TrimSpace(string(rb))
+	if resp.StatusCode >= 300 {
+		return repairAction{}, fmt.Errorf("deepseek HTTP %d", resp.StatusCode)
+	}
+	var out struct {
+		Choices []struct {
+			Message struct {
+				Content string `json:"content"`
+			} `json:"message"`
+		} `json:"choices"`
+	}
+	if e := json.Unmarshal(rb, &out); e != nil || len(out.Choices) == 0 {
+		return repairAction{}, fmt.Errorf("پاسخ DeepSeek نامعتبر")
+	}
+	response = strings.TrimSpace(out.Choices[0].Message.Content)
+	content := response
+	if i := strings.Index(content, "{"); i >= 0 {
+		if j := strings.LastIndex(content, "}"); j > i {
+			content = content[i : j+1]
+		}
+	}
+	if e := json.Unmarshal([]byte(content), &act); e != nil {
+		return repairAction{}, fmt.Errorf("JSON اقدام نامعتبر")
+	}
+	act.Action = strings.ToLower(strings.TrimSpace(act.Action))
+	act.Value = strings.TrimSpace(act.Value)
+	return act, nil
+}
+
+var repairValueRe = regexp.MustCompile(`^[A-Za-z0-9._:\-]{1,253}$`)
+
+func (r *Router) repairApply(ctx context.Context, tok string, cli interface {
+	PutHost(string, string, map[string]any) error
+}, h map[string]any, all []map[string]any, act repairAction) error {
+	id := strv(h["id"])
+	if id == "" {
+		return fmt.Errorf("host id خالی")
+	}
+	cands := repairCandidates(h, all)
+	inCands := func(field, v string) bool {
+		for _, x := range cands[field] {
+			if strings.EqualFold(x, v) {
+				return true
+			}
+		}
+		return false
+	}
+	switch act.Action {
+	case "set_sni", "set_host", "set_address":
+		field := strings.TrimPrefix(act.Action, "set_")
+		if !repairValueRe.MatchString(act.Value) || !inCands(field, act.Value) {
+			return fmt.Errorf("مقدار %s مجاز نیست", act.Value)
+		}
+		h[field] = []string{act.Value}
+	case "set_port":
+		p, err := strconv.Atoi(act.Value)
+		if err != nil || p < 1 || p > 65535 || !inCands("port", strconv.Itoa(p)) {
+			return fmt.Errorf("پورت مجاز نیست")
+		}
+		h["port"] = p
+	case "disable":
+		h["is_disabled"] = true
+	case "enable":
+		h["is_disabled"] = false
+	case "restart_xray":
+		addr := cfgFirst(hfList(h["address"])...)
+		if addr == "" {
+			return fmt.Errorf("آدرس هاست خالی")
+		}
+		if err := r.repairRestartXray(addr); err != nil {
+			return err
+		}
+		return nil
+	default:
+		return fmt.Errorf("اقدام ناشناخته")
+	}
+	return cli.PutHost(tok, id, h)
+}
+
+func (r *Router) repairRollback(tok string, cli interface {
+	PutHost(string, string, map[string]any) error
+}, before map[string]any) error {
+	id := strv(before["id"])
+	if id == "" {
+		return fmt.Errorf("no id")
+	}
+	return cli.PutHost(tok, id, before)
+}
+
+func (r *Router) repairFindServer(addr string) map[string]any {
+	addr = strings.TrimSpace(addr)
+	if addr == "" {
+		return nil
+	}
+	for _, s := range r.srvList() {
+		host := strings.TrimSpace(strv(s["host"]))
+		if host != "" && strings.EqualFold(host, addr) {
+			return s
+		}
+		// Notes are a comma-separated list of the config addresses served by
+		// this SSH target; compare whole entries, never substrings.
+		for _, part := range strings.Split(strv(s["note"]), ",") {
+			if strings.EqualFold(strings.TrimSpace(part), addr) {
+				return s
+			}
+		}
+	}
+	return nil
+}
+
+func (r *Router) repairSSHReady(addr string) bool { return r.repairFindServer(addr) != nil }
+
+// repairChangeDetail records exactly what the feature changed on the panel
+// host or on the exit server, so the history is a change log, not just a list
+// of proposed actions.
+func (r *Router) repairChangeDetail(act repairAction, before, after map[string]any) string {
+	switch act.Action {
+	case "set_sni", "set_host", "set_address":
+		field := strings.TrimPrefix(act.Action, "set_")
+		old := strings.Join(hfList(before[field]), ", ")
+		if old == "" {
+			old = "—"
+		}
+		return fmt.Sprintf("%s: %s → %s", field, old, act.Value)
+	case "set_port":
+		return fmt.Sprintf("port: %s → %s", strv(before["port"]), act.Value)
+	case "disable", "enable":
+		return fmt.Sprintf("is_disabled: %v → %v", boolVal(before["is_disabled"]), act.Action == "disable")
+	case "restart_xray":
+		addr := ""
+		if a := hfList(after["address"]); len(a) > 0 {
+			addr = a[0]
+		}
+		target := addr
+		if s := r.repairFindServer(addr); s != nil {
+			target = strv(s["host"])
+			if name := strv(s["name"]); name != "" {
+				target += " (" + name + ")"
+			}
+		}
+		if target == "" {
+			target = "نامشخص"
+		}
+		return "ری‌استارت Xray روی سرور خروجی " + target
+	}
+	return ""
+}
+
+func (r *Router) repairRestartXray(addr string) error {
+	s := r.repairFindServer(addr)
+	if s == nil {
+		return fmt.Errorf("سرور SSH برای %s پیدا نشد", strings.TrimSpace(addr))
+	}
+	res := r.srvSSH(s, "systemctl restart xray 2>&1 || systemctl restart xray-core 2>&1 || true")
+	if res.Ok {
+		return nil
+	}
+	return fmt.Errorf("%s", truncRune(res.Err, 120))
+}
+
+func repairThroughput(ctx context.Context, c cfgLink, want int) (float64, error) {
+	if want <= 0 {
+		want = 1000000
+	}
+	bin := cfgEnginePath()
+	port, err := cfgFreePort()
+	if err != nil {
+		return 0, err
+	}
+	dir, err := os.MkdirTemp("", "repair-")
+	if err != nil {
+		return 0, err
+	}
+	defer os.RemoveAll(dir)
+	cfgPath := filepath.Join(dir, "config.json")
+	body, _ := json.Marshal(cfgBuildConfig(c, port))
+	if err := os.WriteFile(cfgPath, body, 0o600); err != nil {
+		return 0, err
+	}
+	rctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	var logs lockedBuf
+	cmd := exec.CommandContext(rctx, bin, "run", "-c", cfgPath)
+	cmd.Stderr = &logs
+	cmd.Stdout = &logs
+	if err := cmd.Start(); err != nil {
+		return 0, err
+	}
+	done := make(chan struct{})
+	go func() { _ = cmd.Wait(); close(done) }()
+	defer func() { cancel(); <-done }()
+	proxy := "127.0.0.1:" + strconv.Itoa(port)
+	ready := false
+	for i := 0; i < 80; i++ {
+		select {
+		case <-done:
+			return 0, fmt.Errorf("engine start failed")
+		case <-time.After(50 * time.Millisecond):
+		}
+		cc, e := net.DialTimeout("tcp", proxy, 300*time.Millisecond)
+		if e == nil {
+			cc.Close()
+			ready = true
+			break
+		}
+	}
+	if !ready {
+		return 0, fmt.Errorf("engine not ready")
+	}
+	target := fmt.Sprintf("https://speed.cloudflare.com/__down?bytes=%d", want)
+	u, err := url.Parse(target)
+	if err != nil {
+		return 0, err
+	}
+	tr := &http.Transport{
+		DisableKeepAlives: true,
+		DialContext: func(dctx context.Context, _, _ string) (net.Conn, error) {
+			return cfgSocksDial(dctx, proxy, u.Hostname(), 443)
+		},
+	}
+	defer tr.CloseIdleConnections()
+	hc := &http.Client{Transport: tr, Timeout: 25 * time.Second}
+	req, _ := http.NewRequestWithContext(ctx, http.MethodGet, target, nil)
+	start := time.Now()
+	resp, err := hc.Do(req)
+	if err != nil {
+		return 0, err
+	}
+	defer resp.Body.Close()
+	n, _ := io.Copy(io.Discard, io.LimitReader(resp.Body, int64(want)))
+	el := time.Since(start).Seconds()
+	if n < 1024 || el <= 0 {
+		return 0, fmt.Errorf("download too small")
+	}
+	return float64(n) * 8 / el / 1e6, nil
+}
+
