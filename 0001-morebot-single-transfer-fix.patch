+	vs := DecideAll([]Payment{p1, p2}, []blu.Tx{tx(6509020, now-30, "r1")}, DefaultRule())
+	approved := 0
+	for _, v := range vs {
+		if v.Action == "approve" {
+			approved++
+		}
+	}
+	if approved != 1 {
+		t.Fatalf("one transfer must approve at most one order, got %d: %+v", approved, vs)
+	}
+}
