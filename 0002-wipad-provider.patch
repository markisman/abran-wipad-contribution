+	err := r.bluAutoLogin(context.Background(), blu.New(base), base, acc)
+	if err == nil || !strings.Contains(err.Error(), "ویپاد") {
+		t.Fatalf("wipad auto login must not text, got %v", err)
+	}
+	if _, ok := r.bluPendPort(portOfURL(base)); ok {
+		t.Fatal("wipad auto login must not start a pending login")
+	}
+}
