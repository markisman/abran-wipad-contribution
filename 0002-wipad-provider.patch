+func TestWipadAccountAllowsEmptyPassword(t *testing.T) {
+	accs := []bluAcc{{Name: "ویپاد", URL: "http://127.0.0.1:8089", User: "09121234567", Provider: "wipad"}}
+	acc, ok := bluAccAt(accs, "http://127.0.0.1:8089")
+	if !ok || acc.Provider != "wipad" {
+		t.Fatalf("wipad account should be usable without a password: %+v %v", acc, ok)
+	}
+	bluOnly := []bluAcc{{Name: "بلو", URL: "http://127.0.0.1:8088", User: "u"}}
+	if _, ok := bluAccAt(bluOnly, "http://127.0.0.1:8088"); ok {
+		t.Fatal("blu account without a password must not be usable")
+	}
+}
